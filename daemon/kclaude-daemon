OAUTH_TOKEN_PREFIX = "sk-ant-oat"

# The numbers come off a ping, not off /api/oauth/usage.
#
# /api/oauth/usage is scarce: an account-wide quota, measured (2026-07) at
# roughly one call per two minutes with a slow refill, that 429s for hours once
# drained. Polling it every five minutes is what drained it. Claude Code does
# not have this problem because it barely uses that endpoint.
#
# /v1/messages is not scarce -- Claude Code hammers it all day -- and every 200
# carries anthropic-ratelimit-unified-*, which is the same data, account-wide,
# so it also covers usage from claude.ai or another machine. A ping is 8 input
# tokens and 1 output token of Haiku. At 60s that is ~13k tokens a day against a
# budget measured in millions: cheaper than being wrong about the numbers.
#
# The one real cost: a ping opens a five-hour window if none is running, so the
# widget keeps one open around the clock. That is what primeOnReset does on
# purpose anyway.
DEFAULT_INTERVAL = 60
MIN_INTERVAL = 60
MAX_BACKOFF = 3600
# A window at 100% refuses every request until it turns over, so the daemon
# goes quiet until then rather than backing off into a wall. Nothing waits
# longer than one window's length.
FIVE_HOURS = 5 * 3600
# Wake just after the reset, not exactly on it: clocks disagree by seconds and
# an early ping just earns another refusal.
RESET_SLACK = 10
# A held-down Refresh button must not turn into an API hammer. The usage
# endpoint returns 429 well below one call every 30s, so this is the floor for
# manually requested polls, not a nicety.
MIN_POLL_GAP = 30
# Fable's weekly budget is the one limit the ping cannot see (see ScopedWindows),
# so it costs a usage-endpoint call -- the scarce endpoint this daemon otherwise
# stays off entirely. Measured (2026-09-27) as one call every 65s still answering
# 200, so half an hour is a wide margin: 48 calls a day, against a budget that
# the old 5-minute poll drained into a multi-hour 429.
SCOPED_INTERVAL = 1800
# Ceiling on that interval's growth. A 429 doubles it; without a cap a bad hour
# would park Fable's number for a day.
SCOPED_BACKOFF_MAX = 6 * 3600
# Priming spends quota, so the floor matters more than it does for a poll. One
# five-hour window can only need one prime; an hourly ceiling means a widget
# stuck in a loop costs one tiny message an hour instead of thousands. Kept on
# disk rather than in memory, so a restart loop cannot reset it either.
MIN_PRIME_GAP = 3600
# Refresh the token this long before it actually expires.
TOKEN_SKEW_MS = 5 * 60 * 1000

WINDOW_KEYS = ("five_hour", "seven_day", "thirty_day")


def iso(epoch):
    """Unix epoch -> the ISO-8601 form the file contract uses.

    Total, by design: a value that cannot be formatted -- NaN from a malformed
    header, or an epoch past what time.gmtime accepts -- returns None rather
    than raising, because every caller of this is parsing a response nobody
    promised was well formed, and an exception here takes the whole poll down
    instead of dropping the one field that is wrong.
    """
    try:
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))
    except (OverflowError, OSError, TypeError, ValueError):
        return None


def parse_iso(text):
    """ISO-8601 -> a POSIX timestamp, or None.

    datetime.fromisoformat only learned to read a trailing "Z" in Python 3.11,
    and this file writes exactly that form itself (see iso). Relying on the
    interpreter version would be an undeclared floor on a daemon that packaging
    describes only as "python3", and on an older one *every* reset time here
    would fail to parse -- which does not raise, it silently degrades the whole
    go-quiet-until-reset design into a flat one-hour backoff.

    A value with no offset is read as UTC, matching iso()'s output.
    """
    if not isinstance(text, str) or not text:
        return None
    if text.endswith(("Z", "z")):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=datetime.timezone.utc)
    return parsed.timestamp()


class AuthError(Exception):
    """The credentials are gone or rejected: waiting will not fix it, only the
    user re-authenticating Claude Code will. Surfaced to the widget via the
    "error" key in usage.json, and retried gently in case they just did."""


class CredentialsUnwritable(AuthError):
    """The token was refreshed but the file could not be written back.

    An AuthError because only the user can fix it -- a read-only $HOME, a full
    disk -- and because the alternative is worse: the server has already
    rotated the refresh token, so the copy still on disk is dead. The fresh
    token is kept on the account so a later poll persists it rather than
    spending a second rotation on a token the server will reject.
    """


def write_atomic(path, text, mode=0o600):
    """Write via temp file + rename so readers never observe a partial file."""
    directory = os.path.dirname(path)
    # 0700, not the 0777&~umask this used to take. The directory holds the
    # account ids in its filenames and the usage files beside it, none of which
    # another local user has any business reading. Nothing here needs a wider
    # mode: the widget that reads these files runs as this same user.
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            # chmod before the content lands, so the file is never briefly readable.
            os.fchmod(f.fileno(), mode)
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        # fsync the directory too. os.replace only guarantees the rename reaches
        # the disk once the *parent* has been synced; without this a crash can
        # leave the directory entry pointing at the previous file. For
        # usage.json that costs a poll interval. For .credentials.json it costs
        # the login, because the file we would revert to holds a refresh token
        # the server has already invalidated.
        dir_fd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except BaseException:
        # suppress: never let cleanup replace the original traceback.
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


# An id is part of a filename on both sides of the file contract, so it is held
# to what a filename can carry. 11 bytes of affix ("usage-", ".json") plus a
# 255-byte NAME_MAX leaves 244 as the hard ceiling; 64 is well inside it and
# leaves room for a suffixed name that is not usage.json.
#
# There used to be no cap at all, on either side. An id long enough to overflow
# NAME_MAX made every write to that account's usage file fail with ENAMETOOLONG,
# which the poll's backoff swallowed into "this account silently shows nothing
# for ever" with a single journal line.
MAX_ID_LENGTH = 64


def account_id(raw):
    """"Claude Dad" -> "claude_dad": the key and filename-safe id for an account.

    ASCII alphanumerics only, deliberately. This rule is implemented a second
    time in Accounts.slug, in another language, and the two have to agree
    character for character -- which they did not: Python's str.isalnum() is
    Unicode-aware and the JS regex is not, so "café" became "café" here and
    "caf" there. The collector wrote usage-café.json while the panel watched
    usage-caf.json, and that account showed nothing for ever with no
    diagnostic. Anything else becomes "_", and a result with nothing usable in
    it is rejected by the caller rather than defaulted, since two accounts both
    called "" would collide on every state file they share.
    """
    if not isinstance(raw, str):
        return ""
    slug = "".join(c if c.isascii() and c.isalnum() else "_" for c in raw.strip().lower())
    return "_".join(part for part in slug.split("_") if part)[:MAX_ID_LENGTH].strip("_")


class Account:
    """One Claude account: where its credentials live, and the state that is
    only ever about it.

    Every path an account touches hangs off this object, deliberately. With more
    than one account configured there is exactly one mistake here that cannot be
    undone cheaply: refreshing account A's token and writing it into account B's
    credentials file invalidates B's login, and Claude Code then has to
    re-authenticate. So there is no module-level credentials path left to reach
    for by accident -- every reader and writer takes the account it belongs to.

    The first account keeps the historical unsuffixed filenames. An existing
    install, and anything else already reading usage.json, goes on working
    without being told about any of this.
    """

    def __init__(self, spec, index, state_dir=None):
        self.state_dir = STATE_DIR if state_dir is None else state_dir
        self.index = index
        self.id = account_id(spec.get("id")) if isinstance(spec, dict) else ""
        if isinstance(spec, dict):
            label = spec.get("label")
            path = spec.get("path")
        else:
            label, path = None, None
        # The label is only ever shown, so anything unusable falls back to the id
        # rather than to an empty row in the popup.
        self.label = str(label).strip() if isinstance(label, str) and label.strip() else self.id
        # A path is not allowed to default. Falling back to ~/.claude here would
        # poll someone else's account and file its numbers under this entry's
        # name, which is the one failure mode a list of accounts must not have --
        # so an entry without a usable path is marked invalid and dropped by
        # load_accounts rather than quietly pointed at the default.
        self.path_ok = isinstance(path, str) and bool(path.strip())
        self.config_dir = os.path.expanduser(path.strip()) if self.path_ok else DEFAULT_CONFIG_DIR
        self.credentials_file = os.path.join(self.config_dir, ".credentials.json")

        # Scheduling state, monotonic and per-account. Kept off the object rather
        # than in the loop's locals because a backoff on one account must not
        # delay another's poll, and vice versa: an account in a one-hour error
        # backoff is the one that should wait, not the one that should be stuck
        # waiting with it.
        self.next_due = 0.0
        self.last_poll = 0.0
        self.wake_floor = 0.0
        self.backoff = DEFAULT_INTERVAL

        # A fixed per-account offset, so restarts and the accounts in a list do
        # not all come back on the same second. Drawn once and added to this
        # account's own schedule, rather than added to the loop's sleep: the
        # sleep is shared, so jittering it stretched every effective interval to
        # 60-75s and quietly contradicted the documented 60s cadence.
        self.jitter = random.uniform(0, 15)

        # A token the server has already rotated but that could not be written
        # back. Held here rather than in the credentials file because that file
        # is the thing that could not be written. See save_oauth's caller in
        # refresh_access_token: posting the refresh token again would come back
        # invalid_grant and cost the user their login.
        self.pending_oauth = None

        # From the credentials, not from the config file: the plan decides
        # whether a per-model weekly budget can exist at all, and the user
        # downgrades without telling the widget.
        self.plan = ""
        self.scoped = ScopedWindows(self.state_dir, self)
        self.suffix_files(index)

    def suffix_files(self, index):
        """Point this account's state files at its current slot in the list.

        The first account is unsuffixed, so reordering in the settings page
        moves an account between the historical names and a suffixed one. The
        file it leaves behind is not renamed or deleted: it is rewritten within a
        poll interval, and a migration that lands on the wrong path is worse
        than a stale file that nothing reads any more.
        """
        self.index = index
        suffix = "" if index == 0 else "-" + self.id
        self.usage_file = os.path.join(self.state_dir, "usage" + suffix + ".json")
        self.scoped_file = os.path.join(self.state_dir, "scoped" + suffix + ".json")
        self.prime_stamp_file = os.path.join(self.state_dir, "last-prime" + suffix)
        self.scoped.set_path(self.scoped_file)

    def __repr__(self):
        return f"<Account {self.id!r} {self.config_dir}>"


def default_account(state_dir=None):
    """The one account an install has always had: ~/.claude."""
    return Account({"id": "claude", "label": "claude", "path": DEFAULT_CONFIG_DIR}, 0, state_dir)


def load_accounts(state_dir=None):
    """The configured accounts, in the order the settings page lists them.

    Falls back to the single default account, because a missing accounts.json is
    what every install that predates this feature looks like, and refusing to
    start would take the widget down for everyone who has not opened the
    settings page yet.

    An entry that cannot be used is dropped with a reason in the journal rather
    than failing the whole list: one bad path must not cost the user the
    accounts that are fine. An id collision is the one case that cannot be
    resolved by dropping, since two accounts sharing an id would share every
    state file, so the later one loses.
    """
    try:
        with open(ACCOUNTS_FILE) as f:
            data = json.load(f)
    except FileNotFoundError:
        return [default_account(state_dir)]
    except (OSError, ValueError) as e:
        print(f"kclaude-daemon: {ACCOUNTS_FILE} unreadable ({e}); "
              f"falling back to {DEFAULT_CONFIG_DIR}", file=sys.stderr)
        return [default_account(state_dir)]

    entries = data.get("accounts") if isinstance(data, dict) else None
    if not isinstance(entries, list) or not entries:
        print(f"kclaude-daemon: {ACCOUNTS_FILE} lists no accounts; "
              f"falling back to {DEFAULT_CONFIG_DIR}", file=sys.stderr)
        return [default_account(state_dir)]

    accounts = []
    seen = set()
    # The cap is on how many accounts are *kept*, not on how many entries are
    # read. Slicing the input meant a file whose first MAX_ACCOUNTS entries were
    # all unusable fell through to the default account, even when entry nine was
    # perfectly good -- and the widget, which caps its own output, disagreed
    # with the collector about which rows exist. Both sides cap the kept list.
    for position, entry in enumerate(entries):
        if not isinstance(entry, dict):
            continue
        account = Account(entry, len(accounts), state_dir)
        if not account.id:
            print(f"kclaude-daemon: account {entry!r} has no usable id, skipping", file=sys.stderr)
            continue
        if not account.path_ok:
            # Never defaulted to ~/.claude: see Account.path_ok.
            print(f"kclaude-daemon: account {entry!r} has no usable path, skipping", file=sys.stderr)
            continue
        if account.id in seen:
            print(f"kclaude-daemon: duplicate account id {account.id!r}, skipping", file=sys.stderr)
            continue
        seen.add(account.id)
        accounts.append(account)
        if len(accounts) >= MAX_ACCOUNTS:
            ignored = len(entries) - position - 1
            if ignored > 0:
                print(f"kclaude-daemon: {MAX_ACCOUNTS} accounts is the maximum; "
                      f"ignoring {ignored} more from {ACCOUNTS_FILE}", file=sys.stderr)
            break
    if not accounts:
        print(f"kclaude-daemon: no usable account in {ACCOUNTS_FILE}; "
              f"falling back to {DEFAULT_CONFIG_DIR}", file=sys.stderr)
        return [default_account(state_dir)]
    return accounts


def accounts_file_state():
    """Whether accounts.json is absent, unusable, or readable.

    Absent is the normal case on every install that predates multiple accounts,
    and correctly means the single default account. Present but unreadable is
    a different thing: a damaged or half-written file, which both readers used
    to treat as "no accounts" -- silently repointing the collector at ~/.claude
    and refreshing an account's token the user may not have chosen. The two are
    told apart here so that only the second one keeps the list already running.
    """
    try:
        with open(ACCOUNTS_FILE) as f:
            json.load(f)
    except FileNotFoundError:
        return "missing"
    except (OSError, ValueError):
        return "unreadable"
    return "ok"


def accounts_signature(accounts):
    """What the loop compares to notice that the settings page changed something.

    Label included, because a rename should not restart an account's pacing and
    a path change must, and both arrive as one edited file.
    """
    return tuple((a.id, a.config_dir, a.label) for a in accounts)


def reconcile_accounts(previous, fresh, state_dir=None):
    """Fold a reloaded account list into the running objects.

    An account that is still there keeps its object, and with it its backoff,
    its next-due time and its scoped cache -- a rename or a reordering in the
    settings page must not reset an hour of error backoff or spend an endpoint
    call the last poll already earned. Matching is on id and path, so a changed
    path is deliberately a new account.
    """
    by_key = {(a.id, a.config_dir): a for a in previous}
    merged = []
    for entry in fresh:
        old = by_key.get((entry.id, entry.config_dir))
        if old is not None:
            old.index = len(merged)
            old.label = entry.label
            old.suffix_files(len(merged))
            merged.append(old)
        else:
            merged.append(entry)
    for gone in previous:
        if gone not in merged:
            print(f"kclaude-daemon: account {gone.id!r} removed from the configuration",
                  file=sys.stderr)
    return merged


def single_instance_lock():
    """Return a held lock fd, or None if another daemon already has it.

    Two daemons refreshing concurrently both rotate the refresh token. The loser
    then writes a server-invalidated token into ~/.claude/.credentials.json and
    Claude Code itself has to re-authenticate. Refusing to start twice is worth
    more than the convenience of a second instance.
    """
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    # Held for the process lifetime; closing the fd would release it.
    return fd


class Waker:
    """Lets a signal cut the poll interval short: SIGUSR1 to poll now (the
    widget's Refresh button), SIGUSR2 to open a new five-hour window.

    Uses set_wakeup_fd + select rather than a flag checked around time.sleep:
    PEP 475 makes time.sleep resume after a handler returns, and touching a lock
    from inside a handler can deadlock against the code it interrupted.
    """

    SIGNALS = (signal.SIGUSR1, signal.SIGUSR2)

    def __init__(self):
        self._r, self._w = os.pipe()
        os.set_blocking(self._r, False)
        os.set_blocking(self._w, False)
        signal.set_wakeup_fd(self._w)
        for sig in self.SIGNALS:
            # A Python-level handler has to exist or the signal keeps its default
            # action, which is to kill the process.
            signal.signal(sig, lambda *_: None)

    def wait(self, seconds):
        """Sleep up to `seconds`. Returns the signal numbers that arrived, as a
        set, empty if the wait simply ran out."""
        deadline = time.monotonic() + seconds
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return frozenset()
            try:
                ready, _, _ = select.select([self._r], [], [], remaining)
            except InterruptedError:
                continue
            if not ready:
                return frozenset()
            # set_wakeup_fd writes one byte per signal: the signal number. Both
            # can be pending at once, so read the lot and report all of them.
            try:
                return frozenset(os.read(self._r, 4096))
            except BlockingIOError:
                # select() said readable but the read would block: a spurious
                # wake, not a signal. Returning an empty set here would be
                # indistinguishable from the wait running out, and the caller
                # paces on exactly that difference -- keep waiting instead.
                continue


def load_credentials(account):
    with open(account.credentials_file) as f:
        return json.load(f)


# The only keys a refresh changes. Everything else in the object -- scopes,
# subscriptionType, rateLimitTier, refreshTokenExpiresAt -- belongs to Claude
# Code, and replacing the whole object is how a sibling key *inside*
# claudeAiOauth gets lost in exactly the way mcpOAuth was.
OAUTH_CHANGED_KEYS = ("accessToken", "refreshToken", "expiresAt")


def save_oauth(account, oauth, expected_refresh=None):
    """Merge the refreshed token back into this account's file, re-reading it
    first.

    Claude Code owns this file and updates sibling keys (mcpOAuth,
    organizationUuid) on its own schedule. Re-reading immediately before the
    write shrinks the lost-update window from a whole poll interval to
    microseconds. It cannot close it -- Claude Code does not take our lock -- so
    only the keys we actually changed are written back, and only into a
    claudeAiOauth that is still the one we read.

    An unreadable file is not an empty one. Substituting {} for a failed read is
    what turns a transient parse error -- Claude Code caught mid-write, a
    truncated file, a momentary EIO -- into a permanently deleted mcpOAuth, so
    anything but a genuinely absent file propagates and nothing is written at
    all. Only the absent case creates the file.

    expected_refresh, when given, is the refresh token that was sent to the
    server. If the file no longer holds it, Claude Code re-authenticated while
    this refresh was in flight and the reply about to be written belongs to a
    login that no longer exists. Skipped, and False returned.

    Returns True if the file was written, False if it was deliberately left
    alone.
    """
    try:
        creds = load_credentials(account)
        existed = True
    except FileNotFoundError:
        creds, existed = {}, False
    except (OSError, ValueError):
        # Propagated on purpose: the caller's backoff retries, and the file
        # stays exactly as Claude Code left it.
        raise

    if existed:
        on_disk = creds.get("claudeAiOauth")
        if expected_refresh is not None and isinstance(on_disk, dict):
            current = on_disk.get("refreshToken")
            if current is not None and current != expected_refresh:
                return False
        target = on_disk if isinstance(on_disk, dict) else {}
    else:
        # Nothing to preserve, and `oauth` is the whole of what we know, so take
        # all of it -- otherwise the plan badge loses subscriptionType.
        target = dict(oauth)
    creds["claudeAiOauth"] = target
    for key in OAUTH_CHANGED_KEYS:
        if key in oauth:
            target[key] = oauth[key]
    # 0600: the file holds live OAuth tokens.
    write_atomic(account.credentials_file, json.dumps(creds, indent=2), mode=0o600)
    return True


def refresh_access_token(account, oauth):
    """Exchange the refresh token. The server rotates it, so persist at once."""
    sent = oauth.get("refreshToken")
    body = json.dumps({
        "grant_type": "refresh_token",
        "refresh_token": sent,
        "client_id": CLIENT_ID,
    }).encode()
    req = urllib.request.Request(TOKEN_URL, data=body, headers={"Content-Type": "application/json"}, method="POST")
    try:
        with OPENER.open(req, timeout=30) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        # 400 is what an invalid/rotated-away refresh token actually returns
        # (invalid_grant). 5xx and network errors stay retryable errors.
        if e.code in (400, 401, 403):
            raise AuthError(f"Claude Code login expired for {account.label}: "
                            "run 'claude' in that config directory and sign in again") from e
        raise
    # Validated into a *local* dict before `oauth` is touched. A 200 whose body
    # is not a token reply has not rotated anything, so it is an ordinary
    # retryable protocol error -- but it must be raised before any mutation, or
    # a half-applied reply is what ends up on disk.
    if not isinstance(data, dict) or not isinstance(data.get("access_token"), str):
        raise ValueError("the token endpoint replied 200 without an access token")
    fresh = dict(oauth)
    fresh["accessToken"] = data["access_token"]
    if "refresh_token" in data:
        fresh["refreshToken"] = data["refresh_token"]
    # No expires_in means the expiry is *unknown*, not unchanged: leaving the
    # stale clock in place makes token_expired() true for ever, which turns
    # every poll into a token request against the endpoint.
    fresh["expiresAt"] = 0
    if "expires_in" in data:
        with contextlib.suppress(TypeError, ValueError):
            fresh["expiresAt"] = int(time.time() * 1000) + int(data["expires_in"]) * 1000

    # The server has rotated the refresh token by this point and the only copy
    # of the new one is in `fresh`, so the write is the last thing that can go
    # wrong -- and if it does, the fresh token is kept on the account so a later
    # poll persists it instead of POSTing a token the server has invalidated.
    try:
        wrote = save_oauth(account, fresh, expected_refresh=sent)
    except OSError as e:
        account.pending_oauth = fresh
        raise CredentialsUnwritable(
            f"could not save the refreshed token for {account.label} ({e}); "
            "free some disk or check the file's permissions, then hit Refresh") from e
    if not wrote:
        # Claude Code re-authenticated underneath us. Our reply is for a login
        # that no longer exists, so it is discarded rather than written.
        return oauth["accessToken"]
    oauth.clear()
    oauth.update(fresh)
    return oauth["accessToken"]


def token_expired(oauth):
    expires_at = oauth.get("expiresAt")
    if not isinstance(expires_at, (int, float)):
        return False  # unknown expiry -> let the 401 path handle it
    return time.time() * 1000 >= expires_at - TOKEN_SKEW_MS


def read_plan(oauth):
    """The subscription type out of a credentials blob, or "" if absent.

    Only ever used to skip work that cannot have an answer (see
    ScopedWindows.refresh) and to label the account in the widget. An
    unrecognised value is passed through rather than guessed at.
    """
    plan = oauth.get("subscriptionType")
    return plan.strip().lower() if isinstance(plan, str) and plan.strip() else ""


def claude_cli_version():
    """The newest installed claude version, or the fallback.

    Numeric sort, not lexicographic: "2.1.220" has to beat "2.1.99".
    """
    try:
        names = os.listdir(CLAUDE_VERSIONS_DIR)
    except OSError:
        return CLAUDE_VERSION_FALLBACK
    versions = []
    for name in names:
        parts = name.split(".")
        if parts and all(p.isdigit() for p in parts):
            versions.append((tuple(int(p) for p in parts), name))
    return max(versions)[1] if versions else CLAUDE_VERSION_FALLBACK


# One per process, like claude-cli's per-session id. Read once: the version
# cannot change under a running daemon without the systemd unit restarting it.
CLI_VERSION = claude_cli_version()
SESSION_ID = str(uuid.uuid4())


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse every 3xx, rather than following it.

    CPython's default redirect_request copies every header across a redirect
    except content-length and content-type -- so `Authorization: Bearer
    sk-ant-oat01-...` follows a 302 to whatever host sent it, and the daemon
    would then hand a live OAuth token to a third party. None of the four
    endpoints below redirect in normal operation, so refusing costs nothing.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


# One opener for every request, so the guard above cannot be forgotten by a
# caller added later the way a per-call timeout can be.
OPENER = urllib.request.build_opener(_NoRedirect)


def cli_headers(access_token):
    """The header block claude-cli puts on every authenticated request."""
    return {
        "Authorization": f"Bearer {access_token}",
        "anthropic-version": "2023-06-01",
        "Content-Type": "application/json",
        "x-app": "cli",
        "User-Agent": f"claude-cli/{CLI_VERSION} (external, cli)",
        "X-Claude-Code-Session-Id": SESSION_ID,
    }


def fetch_usage(access_token):
    # Matches claude-cli's own GET of this endpoint: the shared block and
    # nothing else -- it sends no anthropic-beta here, so neither do we.
    req = urllib.request.Request(USAGE_URL, headers=cli_headers(access_token))
    with OPENER.open(req, timeout=10) as resp:
        return json.load(resp)


def with_token(account, call):
    """Run call(access_token) for one account, refreshing its token once if the
    server rejects it.

    Every authenticated request goes through here, so the refresh-on-401 rule
    cannot be forgotten by a new caller, and so the plan is picked up on the same
    read that authenticates.
    """
    # A previous refresh rotated the token server-side but could not write it
    # back. Persist that one first: it is the only copy of a live refresh token,
    # and posting the dead one to the endpoint again would come back
    # invalid_grant and cost the user their login. If the file is still
    # unwritable this raises, which is the honest outcome -- the next poll
    # retries, and the schedule backs off around it.
    if account.pending_oauth is not None:
        save_oauth(account, account.pending_oauth)
        account.pending_oauth = None

    try:
        oauth = load_credentials(account)["claudeAiOauth"]
    except FileNotFoundError:
        raise AuthError(f"No Claude Code credentials in {account.config_dir}: "
                        "run 'claude' there and sign in") from None
    except (KeyError, ValueError):
        raise AuthError(f"{account.config_dir} has no Claude Code OAuth entry: "
                        "run 'claude' there and sign in") from None
    account.plan = read_plan(oauth)
    # Refresh up front when the token is known-expired, instead of burning a
    # request to discover it.
    refreshed = token_expired(oauth)
    access_token = refresh_access_token(account, oauth) if refreshed else oauth["accessToken"]
    try:
        return call(access_token)
    except urllib.error.HTTPError as e:
        # At most one rotation per call. Refreshing again on a token that was
        # minted seconds ago spends a second rotation and then reports whatever
        # the retry fails with, which says nothing about the real problem.
        if e.code != 401 or refreshed:
            raise
        return call(refresh_access_token(account, oauth))


def get_usage(account):
    return with_token(account, fetch_usage)


def messages_request(access_token, body, what):
    """A /v1/messages request, built but not sent, so a test can inspect it.

    Authorization is the OAuth bearer token and nothing else: no x-api-key
    header, and no ANTHROPIC_API_KEY is read anywhere in this file, so there is
    no path by which this request reaches API billing. Every caller spends
    subscription quota, so every caller goes through the same allowlist.
    """
    if not isinstance(access_token, str) or not access_token.startswith(OAUTH_TOKEN_PREFIX):
        raise AuthError(
            f"refusing to {what}: the credential is not a Claude Code OAuth token "
            f"(expected {OAUTH_TOKEN_PREFIX}...), and spending must only ever come "
            "out of the subscription")
    return urllib.request.Request(MESSAGES_URL, data=json.dumps(body).encode(), method="POST", headers={
        **cli_headers(access_token),
        "anthropic-beta": OAUTH_BETA,
    })


def prime_request(access_token):
    """The priming request: opens a five-hour window, deliberately."""
    return messages_request(access_token, {
        "model": PRIME_MODEL,
        "max_tokens": PRIME_MAX_TOKENS,
        "system": PRIME_SYSTEM,
        "messages": [{"role": "user", "content": PRIME_TEXT}],
    }, "prime")


def ping_request(access_token):
    """The usage ping: sent for its response headers, not its reply."""
    return messages_request(access_token, {
        "model": PRIME_MODEL,
        "max_tokens": PING_MAX_TOKENS,
        "messages": [{"role": "user", "content": PING_TEXT}],
    }, "ping")


def usage_from_headers(headers):
    """anthropic-ratelimit-unified-* -> the same shape /api/oauth/usage returns.

    Same shape on purpose, percentages and all, so normalize_windows stays the
    one place that knows what the widget wants -- the headers give a 0-1
    fraction and a unix epoch, the endpoint gives 0-100 and an ISO string.
    """
    raw = {}
    for key, prefix in (("five_hour", "5h"), ("seven_day", "7d")):
        # Parsed independently, and a value only kept if it is a real finite
        # number. Sharing one try used to mean a fractional reset epoch
        # ("1759...0.0", which servers do send) threw away a utilization that
        # had already parsed -- and because a one-window dict is still truthy,
        # collect then saw a reply and never fell back to the endpoint, so the
        # five-hour bar simply vanished from the panel with nothing said.
        try:
            utilization = float(headers.get(f"anthropic-ratelimit-unified-{prefix}-utilization"))
        except (TypeError, ValueError):
            continue
        if not math.isfinite(utilization):
            # float("nan") and float("inf") parse cleanly and would otherwise
            # ride all the way into usage.json, where json.dumps writes a bare
            # NaN token that is not valid JSON at all -- and the widget's
            # JSON.parse rejects, taking the account offline. Cheaper to refuse
            # the value here than to discover it in the reader.
            continue
        try:
            reset = int(float(headers.get(f"anthropic-ratelimit-unified-{prefix}-reset")))
        except (TypeError, ValueError):
            continue
        moment = iso(reset)
        if moment is None:
            continue
        raw[key] = {
            "utilization": utilization * 100.0,
            "resets_at": moment,
        }
    return raw


def ping_usage(account):
    """Read the usage numbers off a ~9-token message instead of the endpoint.

    A 429 here means the account is out of quota, and the refusal carries the
    same headers the success would have -- so it is data, not an error. Reading
    it is what lets the loop go quiet until the window resets instead of
    retrying into a wall.
    """
    def send(access_token):
        try:
            with OPENER.open(ping_request(access_token), timeout=30) as resp:
                return usage_from_headers(resp.headers)
        except urllib.error.HTTPError as e:
            if e.code != 429:
                raise
            # ponytail: unverified -- reproducing it means exhausting a real
            # five-hour window. If the refusal turns out to carry no headers,
            # this falls through to the endpoint and then to plain backoff,
            # which is the old behaviour, so being wrong here costs nothing.
            windows = usage_from_headers(e.headers)
            if not windows:
                raise
            return windows

    return with_token(account, send)


def exhausted_until(raw, now=None):
    """Seconds until every exhausted window has reset, or None if none is.

    At 100% the next ping cannot succeed: it would be refused until the window
    turns over. So the only useful thing to do is wait for the reset -- and
    then ping once, which opens the new window.

    Every window is checked, not just the five-hour one: a spent weekly budget
    refuses the same request for days.
    """
    now = time.time() if now is None else now
    waits = []
    if not isinstance(raw, dict):
        return None
    for window in raw.values():
        if not isinstance(window, dict):
            continue
        utilization = window.get("utilization")
        if not isinstance(utilization, (int, float)) or isinstance(utilization, bool):
            continue
        # NaN compares False against every bound, so `utilization < 100.0` alone
        # reads a NaN window as spent -- and then this returns a five-hour wait
        # for a window that is in no such state. Checked explicitly.
        if not math.isfinite(utilization) or utilization < 100.0:
            continue
        reset = parse_iso(window.get("resets_at"))
        if reset is None:
            # Exhausted with no usable reset time to wait for. An hour is the
            # wrong answer by at most an hour, and never a busy loop.
            waits.append(MAX_BACKOFF)
            continue
        # A little past the reset, not exactly on it: server and local clocks
        # disagree by seconds, and waking early just earns another refusal.
        # Capped, so a bogus timestamp cannot park the daemon for a week, and
        # floored at MIN_POLL_GAP: a reset that has already passed used to
        # produce exactly RESET_SLACK (10s), which is below this daemon's own
        # 30s floor and six times below its 60s cadence -- a clock skew or a
        # stale header, and the refusal being answered is pinged every ten
        # seconds for the rest of the day.
        waits.append(min(FIVE_HOURS, max(0.0, reset - now) + RESET_SLACK))
    return max(waits) if waits else None




def last_prime_at(account):
    """When this account's last prime went out, as a wall-clock epoch.

    Per account, because the two limits are per account: priming one account
    must not consume the other's hourly allowance, or a second account would
    silently never be primed.

    Wall clock rather than monotonic because this has to survive a restart: an
    in-memory counter would let a crash-restart loop spend once per crash, which
    is exactly the case MIN_PRIME_GAP exists to bound.
    """
    try:
        with open(account.prime_stamp_file) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return float("-inf")


def record_prime(account, when=None):
    write_atomic(account.prime_stamp_file, str(time.time() if when is None else when), mode=0o600)


def prime_gap_elapsed(account):
    """True if enough time has passed since this account's last prime.

    A stamp in the future means the clock moved backwards (an NTP step, a
    suspend). Treat that as unknown and allow, rather than locking priming out
    until the clock catches up.
    """
    since = time.time() - last_prime_at(account)
    return not (0 <= since < MIN_PRIME_GAP), since


def prime_session(account):
    """Send one message, so this account's five-hour window starts now.

    Costs a sliver of the quota this daemon exists to watch. That is the trade
    the setting is there to make: the window opens on a schedule the user picked
    instead of whenever they happen to type something.

    Returns (headers, model). The reply's own rate-limit headers are the numbers
    for the window this call just opened, so the caller gets the fresh state for
    free instead of spending a second request to ask for it.
    """
    def send(access_token):
        with OPENER.open(prime_request(access_token), timeout=30) as resp:
            return resp.headers, json.load(resp)

    headers, reply = with_token(account, send)
    # Stamp only once the request came back: a failed prime must not consume the
    # hourly allowance, or one outage would suppress the next real attempt too.
    record_prime(account)
    # The reply is discarded, but its model confirms the request was really
    # served rather than answered from some cache or proxy.
    print(f"kclaude-daemon: session primed for {account.label} "
          f"({reply.get('model', 'unknown model')})", file=sys.stderr)
    return headers, reply


def normalize_window(window):
    """API percentages (0-100) -> the widget's 0.0-1.0 model, or None.

    None rather than 0.0 for anything unusable, so a window with no real number
    is dropped rather than drawn as an empty bar that looks like good news.
    """
    if not isinstance(window, dict):
        return None
    utilization = window.get("utilization")
    # bool is an int subclass, and utilization: true is not a percentage.
    if not isinstance(utilization, (int, float)) or isinstance(utilization, bool):
        return None
    # Finite and in range. NaN survives every `isinstance` check and compares
    # False against everything, so without this a single bad number reaches
    # json.dumps, which writes a bare NaN token that is not valid JSON and that
    # the widget's JSON.parse therefore rejects. Above 100 is out of contract
    # too: the widget would draw a bar pinned at full next to a label reading
    # "550%".
    if not math.isfinite(utilization):
        return None
    return {"utilization": min(100.0, max(0.0, utilization)) / 100.0,
            "resetAt": window.get("resets_at")}


def normalize_windows(raw):
    """API shape -> the widget's windows, keeping only the ones we know.

    An allowlist, not everything the response happens to contain: the usage
    endpoint returns a long tail of sibling keys, some of them real dicts (a
    0% one at that), and a window the widget invents a name for is worse than a
    window it leaves out. Scoped limits are added deliberately, by name, in
    ScopedWindows.apply.
    """
    windows = {}
    for key in WINDOW_KEYS:
        window = normalize_window(raw.get(key))
        if window is not None:
            windows[key] = window
    return windows


def window_key(name):
    """"Fable" -> "fable": the window id the file and the widget agree on.

    Empty for anything that is not a name with something in it, so a limit
    whose scope is malformed is dropped rather than filed under "None".
    """
    if not isinstance(name, str):
        return ""
    slug = "".join(c if c.isalnum() else "_" for c in name.strip().lower())
    return "_".join(part for part in slug.split("_") if part)


def scoped_windows(payload):
    """limits[] -> the per-model weekly windows, in the API's own units.

    API shape on purpose, like usage_from_headers, so normalize_windows stays
    the one place that knows what the widget wants.

    Fable's budget arrives here and nowhere else. It is absent from the
    anthropic-ratelimit-unified-* headers the ping reads -- verified against a
    live Max-plan response (2026-09-27), which carried 5h and 7d and nothing
    else -- so the usage endpoint is the only place this can come from. That is
    the entire reason ScopedWindows exists.

    The endpoint's shape for one of these:

        {"kind": "weekly_scoped", "group": "weekly", "percent": 22,
         "resets_at": "2026-09-29T19:59:59.622752+00:00",
         "scope": {"model": {"id": null, "display_name": "Fable"}}}
    """
    limits = payload.get("limits") if isinstance(payload, dict) else None
    if not isinstance(limits, list):
        return {}
    raw = {}
    for limit in limits:
        if not isinstance(limit, dict) or limit.get("kind") != "weekly_scoped":
            continue
        scope = limit.get("scope")
        model = scope.get("model") if isinstance(scope, dict) else None
        if not isinstance(model, dict):
            continue
        key = window_key(model.get("display_name"))
        percent = limit.get("percent")
        if key and isinstance(percent, (int, float)) and not isinstance(percent, bool):
            raw[key] = {"utilization": percent, "resets_at": limit.get("resets_at")}
    return raw


class ScopedWindows:
    """One account's per-model weekly windows, which only the usage endpoint
    reports.

    Kept on disk, not just in memory, because the alternative is a daemon that
    spends an endpoint call on every start -- and a restart loop would turn that
    into the exact hammering the ping was written to avoid.

    Every entry here is older than the file around it by construction, so each
    carries its own updatedAt and the widget can say so rather than presenting
    half-hour-old numbers with the same confidence as the one-minute-old ones.

    Per account, not per process: the endpoint quota is per account, so two
    accounts have two independent budgets and two independent caches.
    """

    def __init__(self, path, account=None):
        self._path = path
        self._account = account
        self._windows = {}
        self._fetched_at = 0.0
        self._next_attempt = 0.0
        self._backoff = SCOPED_INTERVAL
        self._load()

    def set_path(self, path):
        """Follow the account to a new slot's filename, reloading from it."""
        if path == self._path:
            return
        self._path = path
        self._windows = {}
        self._fetched_at = 0.0
        self._next_attempt = 0.0
        self._load()

    def _load(self):
        try:
            with open(self._path) as f:
                data = json.load(f)
        except (OSError, ValueError):
            return
        if not isinstance(data, dict):
            return
        # Which account this cache belongs to. The file name is derived from the
        # account's *position* in the list, so reordering the settings page
        # points a slot at a different account's file -- and without this the
        # account that moved would adopt its new neighbour's Fable window and
        # publish another account's percentage under its own name. A cache that
        # does not claim this account is discarded rather than believed.
        owner = data.get("account")
        mine = self._account.id if self._account is not None else ""
        if owner != mine:
            return
        windows = data.get("windows")
        if isinstance(windows, dict):
            self._windows = windows
        try:
            self._fetched_at = float(data.get("fetchedAt"))
        except (TypeError, ValueError):
            return
        # Wall clock, not monotonic, so a restart does not reset the clock and
        # immediately spend a call the last process already earned the right to
        # spend.
        self._next_attempt = self._fetched_at + self._backoff

    def _save(self):
        write_atomic(self._path, json.dumps(
            {"account": self._account.id if self._account is not None else "",
             "windows": self._windows, "fetchedAt": self._fetched_at}, indent=2), mode=0o600)

    def due(self, now=None):
        return (time.time() if now is None else now) >= self._next_attempt

    def refresh(self, fetch=None):
        """One endpoint read, if one is due. True if it happened.

        Never raises. This is an extra on top of a poll that already works, and
        the auth and rate-limit rules belong to the ping loop: duplicating them
        here would be a second place to get them wrong, and this is the place
        that must never be the one to hammer the endpoint.
        """
        now = time.time()
        if not self.due(now):
            return False

        # A plan with no per-model weekly budget cannot answer this, and the
        # endpoint is the scarce one. Measured (2026-09-27): a pro account
        # returns limits[] with only session and weekly_all, and scoped_windows
        # of that is {}. So skip the call rather than spend a scarce call to be
        # told nothing, and drop any window a downgrade left behind -- otherwise
        # an account that used to be Max keeps drawing a Fable bar for ever.
        if self._account is not None and self._account.plan == "pro":
            if self._windows:
                self._windows = {}
                self._fetched_at = now
                self._save()
            self._next_attempt = now + self._backoff
            return False

        try:
            payload = (get_usage if fetch is None else fetch)(self._account)
        except Exception as e:
            self._backoff = min(self._backoff * 2, SCOPED_BACKOFF_MAX)
            self._next_attempt = now + retry_after(e, self._backoff)
            label = self._account.label if self._account is not None else "default"
            print(f"kclaude-daemon: scoped limits unavailable for {label} ({e}); "
                  f"retrying in {(self._next_attempt - now) / 60:.0f}m", file=sys.stderr)
            return False
        windows = scoped_windows(payload)
        # An empty result is a real answer, not a failure: remembering that is
        # the point of polling. Losing them would make a plan downgrade leave a
        # phantom bar forever.
        self._windows = windows
        self._fetched_at = now
        self._backoff = SCOPED_INTERVAL
        self._next_attempt = now + self._backoff
        self._save()
        return True

    def exhausted_until(self, now=None):
        """The wait for a spent scoped window, or None. See exhausted_until.

        A spent Fable budget refuses the same requests a spent session window
        does, and the poll cannot see it -- so it has to be considered here or
        the loop pings into a wall every interval until the week is out.
        """
        return exhausted_until(self._windows, now)

    def apply(self, windows):
        """Merge into a normalized windows dict, in place, and return it.

        A window the poll reports itself is never overwritten: this is the slow
        path and the fast one is more accurate whenever they disagree.
        """
        if not self._windows or not self._fetched_at:
            return windows
        stamp = iso(self._fetched_at)
        for key, raw in self._windows.items():
            if key in windows:
                continue
            window = normalize_window(raw)
            if window is not None:
                window["updatedAt"] = stamp
                windows[key] = window
        return windows


def write_usage(account, raw, scoped=None):
    windows = normalize_windows(raw)
    if not windows:
        raise ValueError(f"no usable windows in response (keys: {sorted(raw)})")
    if scoped is not None:
        scoped.apply(windows)
    payload = {
        "windows": windows,
        "updatedAt": iso(time.time()),
        # Which account these numbers are. The file name carries an id too, but
        # it is derived from the account's *position* in the list, so a reorder
        # in the settings page moves a filename between accounts for a poll
        # interval. This key does not move, so the widget can tell "this file is
        # briefly stale" from "this file is now someone else's" and refuse the
        # second rather than draw it. Optional on the way in: a hand-written
        # file, or one from a collector older than this key, simply omits it and
        # is taken at its word.
        "account": account.id,
    }
    # The plan is only knowable from the credentials, which the widget must not
    # read -- they hold live tokens. So the collector publishes it, and the
    # widget treats it as optional so a hand-written usage file still works.
    if account.plan:
        payload["plan"] = account.plan
    # allow_nan=False: a NaN or Infinity reaching this point would be written as
    # a bare token that is not JSON at all, and the widget's JSON.parse would
    # reject the whole document and take the account offline. Refusing to write
    # turns that into a ValueError, which the caller's existing backoff path
    # already handles -- a wrong number must not become a lost file.
    write_atomic(account.usage_file,
                 json.dumps(payload, indent=4, allow_nan=False))


def write_error(account, message):
    """Put an auth problem in this account's usage.json without discarding the
    last good numbers: the widget keeps showing them (as stale) alongside the
    message. A successful poll rewrites the file without the key, clearing it.

    Scoped to the account that failed, so one dead login cannot blank out the
    other account's numbers.
    """
    try:
        with open(account.usage_file) as f:
            payload = json.load(f)
        if not isinstance(payload, dict):
            payload = {}
    except (OSError, ValueError):
        payload = {}
    payload.setdefault("windows", {})
    payload.setdefault("updatedAt", iso(time.time()))
    payload["error"] = message
    # Set, not defaulted: an error is exactly when the widget most needs to know
    # whose file it is reading, since this path is also what runs when the file
    # is found damaged.
    payload["account"] = account.id
    write_atomic(account.usage_file, json.dumps(payload, indent=4))


def retry_after(error, fallback):
    """Honour Retry-After on 429/503 when the server supplies one."""
    try:
        # Capped: a bogus or hostile header must not park the daemon for a week.
        return min(MAX_BACKOFF, max(fallback, int(error.headers.get("Retry-After"))))
    except (AttributeError, TypeError, ValueError):
        return fallback


def collect(account):
    """One round of numbers for one account: the ping, with the usage endpoint as
    the fallback.

    The endpoint stays reachable for the cases the headers do not cover -- a
    retired ping model, a window key this account has that the headers do not
    report -- but it is no longer on the hot path, which is the whole point.
    """
    try:
        windows = ping_usage(account)
        if windows:
            return windows
        # A 200 with no rate-limit headers on it. Not an error, and that is the
        # trap: without this the daemon would back off forever on a widget that
        # never updates again, because nothing ever raised.
        reason = "ping carried no rate-limit headers"
    except AuthError:
        raise
    except Exception as e:
        reason = f"ping failed ({e})"
    print(f"kclaude-daemon: {account.label}: {reason}, falling back to the usage endpoint",
          file=sys.stderr)
    return get_usage(account)


def parse_interval(argv):
    if len(argv) <= 1:
        return DEFAULT_INTERVAL
    try:
        return max(MIN_INTERVAL, int(argv[1]))
    except ValueError:
        raise SystemExit(f"kclaude-daemon: interval must be a whole number of seconds, got {argv[1]!r}")


def poll_account(account, interval):
    """One poll of one account. Sets its next_due and wake_floor. Never raises.

    Failure is contained here rather than around the loop, because one account's
    dead login must not stop the other one updating: a panel that silently
    freezes a working account because a second one needs re-authenticating is
    worse than one row saying what is wrong.
    """
    now = time.monotonic()
    account.last_poll = now
    delay = interval
    try:
        # Due-checked, so this costs nothing on the poll cadence it does not
        # serve; see SCOPED_INTERVAL for why it is as slow as it is.
        account.scoped.refresh()
        raw = collect(account)
        write_usage(account, raw, account.scoped)
        account.backoff = interval
        spent = exhausted_until(raw)
        # The poll only reports the windows it can see. A spent Fable budget
        # refuses the request just as hard, and the daemon has to go quiet for
        # that too or it spends the day pinging a wall.
        if spent is None:
            spent = account.scoped.exhausted_until()
        # Floored at MIN_POLL_GAP even when the wait is a real one, so no
        # arithmetic upstream can turn "this window is spent" into a faster poll
        # than this daemon is willing to make.
        delay = interval if spent is None else max(spent, MIN_POLL_GAP)
        # Out of quota is not a pace to nudge: a Refresh click cannot buy a
        # number the server will not give, so the wait is the floor too.
        account.wake_floor = MIN_POLL_GAP if spent is None else delay
        if spent is not None:
            print(f"kclaude-daemon: {account.label}: limit reached, quiet for {spent / 60:.0f}m "
                  "until the window resets", file=sys.stderr)
    except AuthError as e:
        print(f"kclaude-daemon: {e}", file=sys.stderr)
        # The schedule is set before the diagnostic is written, not after. This
        # handler is the one place that does I/O of its own, and an unwritable
        # state directory must degrade the file rather than end the process --
        # one read-only directory plus one expired login used to take down every
        # account, and Restart=on-failure turned it into a 30-second loop.
        delay = account.backoff
        account.backoff = min(account.backoff * 2, MAX_BACKOFF)
        # The user's next move is re-authenticating and hitting Refresh, so
        # unlike the generic backoff below, let a manual poll through at the
        # normal pace. If they have not re-authed yet it costs one token
        # request per click, floored at MIN_POLL_GAP.
        account.wake_floor = MIN_POLL_GAP
        try:
            write_error(account, str(e))
        except (OSError, ValueError) as io_error:
            print(f"kclaude-daemon: {account.label}: could not record the error in "
                  f"{account.usage_file} ({io_error})", file=sys.stderr)
    except Exception as e:
        print(f"kclaude-daemon: {account.label}: {e}", file=sys.stderr)
        # Exponential backoff so a rate limit or an outage is not hammered.
        delay = retry_after(e, account.backoff)
        account.backoff = min(account.backoff * 2, MAX_BACKOFF)
        # While backing off, a refresh request must not short-circuit the wait:
        # that is exactly how one 429 becomes a hammer.
        account.wake_floor = delay
    finally:
        # last, and unconditionally: every path above sets delay, and the one
        # thing that must always happen is that this account is scheduled again.
        # The jitter only ever lengthens a wait, so it cannot become a way round
        # the floors above.
        account.next_due = now + delay + account.jitter


def seconds_until_next(accounts):
    """How long until the most urgent account is due. Never negative.

    The minimum across accounts, not one shared interval: an account sitting in
    an hour of error backoff must not hold the others at that cadence, and a
    limit that resets in four minutes must not be polled at the slowest
    account's pace.
    """
    now = time.monotonic()
    return max(1.0, min(a.next_due for a in accounts) - now)


def request_poll(accounts):
    """Bring every account forward to the earliest a signal is allowed to.

    The floor is the account's own wake_floor, not zero: a refresh must not
    become a way around the pacing a 429 or a spent limit is enforcing, and
    during an error backoff that floor is the whole backoff, so no signal can
    short-circuit it.
    """
    for account in accounts:
        account.next_due = min(account.next_due, account.last_poll + account.wake_floor)
    print("kclaude-daemon: poll requested", file=sys.stderr)


def prime_due_accounts(accounts):
    """Open the next five-hour window for every account that has run out.

    One signal covers all of them: the widget cannot say which account's clock
    ran out, and picking one would leave the others to be primed by hand. Each
    account is rate-limited by its own stamp, so this costs one tiny message per
    account per window and the accounts stay independent.
    """
    for account in accounts:
        elapsed, since = prime_gap_elapsed(account)
        if not elapsed:
            print(f"kclaude-daemon: prime requested, refused for {account.label}: only "
                  f"{since / 60:.0f}m since the last one", file=sys.stderr)
            continue
        try:
            headers, _reply = prime_session(account)
            # The prime's own reply carries the rate-limit headers for the window
            # it just opened, so the numbers update for free rather than costing
            # a second request. Some response can arrive without them; then fall
            # back to a real poll.
            fresh = usage_from_headers(headers)
            write_usage(account, fresh if fresh else collect(account), account.scoped)
            # The prime is what un-exhausted the window: the quiesce and the error
            # backoff were both derived from numbers that no longer hold. Waiting
            # out the rest of a sleep a prime has just made obsolete is how the
            # file sat frozen at 100% for up to five hours after the window had
            # already reopened.
            account.wake_floor = 0.0
            account.next_due = time.monotonic()
        except AuthError as e:
            # The prime itself may be the thing that found the login dead. Say so,
            # and leave the account's own error handling to the poll at the top of
            # the loop.
            print(f"kclaude-daemon: prime failed for {account.label}: {e}", file=sys.stderr)
        except Exception as e:
            # A failed prime must not disturb the poll loop: the widget keeps
            # working, and the reason is in the journal. The schedule stays as it
            # was, since nothing proved it obsolete.
            print(f"kclaude-daemon: prime failed for {account.label}: {e}", file=sys.stderr)


def reload_accounts(accounts):
    """Pick up an edited accounts.json without a restart.

    The settings page writes the whole list on Apply, so the file is re-read once
    per loop iteration and compared. Accounts that are still there keep their
    pacing and their scoped cache; only genuinely new ones start cold.

    Reloaded against the state directory the running accounts were built with,
    not whatever the module global currently says: a reload that quietly moved
    every account's state files would strand the numbers the widget is reading.
    """
    state_dir = accounts[0].state_dir if accounts else None
    if accounts_file_state() == "unreadable":
        # Failing closed. The file is there and cannot be parsed, which is a
        # transient or damaged state -- not a decision to watch ~/.claude. The
        # accounts already loaded keep being polled exactly as they were.
        print(f"kclaude-daemon: {ACCOUNTS_FILE} is present but unreadable; "
              f"keeping the {len(accounts)} account(s) already running", file=sys.stderr)
        return accounts
    fresh = load_accounts(state_dir)
    if accounts_signature(fresh) == accounts_signature(accounts):
        return accounts
    print("kclaude-daemon: account configuration changed, reloading", file=sys.stderr)
    known = {id(a) for a in accounts}
    merged = reconcile_accounts(accounts, fresh)
    for account in merged:
        # Only new ones are worth announcing: a rename or a reorder keeps the same
        # objects, and re-listing them every pass would bury a real change.
        if id(account) not in known:
            print(f"kclaude-daemon: now watching {account.label!r} at {account.config_dir} "
                  f"-> {account.usage_file}", file=sys.stderr)
    return merged


def main():
    interval = parse_interval(sys.argv)
    try:
        lock = single_instance_lock()
    except OSError as e:
        # The one permanent condition this has: an unwritable state directory.
        # Exit 0 for the same reason the other exit below does -- a condition
        # that will still be there in 30 seconds must not become a restart loop,
        # and a traceback says less than the path and the errno do.
        print(f"kclaude-daemon: cannot use the lock file in {STATE_DIR} ({e}); not starting",
              file=sys.stderr)
        return
    if lock is None:
        # Exit 0: this is the expected outcome of starting a second copy, not a
        # failure for systemd to restart in a loop.
        print("kclaude-daemon: another instance is already running, exiting", file=sys.stderr)
        return
    waker = Waker()
    accounts = load_accounts()
    for account in accounts:
        print(f"kclaude-daemon: watching {account.label!r} at {account.config_dir} "
              f"-> {account.usage_file}", file=sys.stderr)
    while True:
        accounts = reload_accounts(accounts)
        now = time.monotonic()
        for account in accounts:
            # Per account rather than one shared cadence, so a fresh account is
            # picked up on the next pass and a backed-off one is simply skipped.
            if now >= account.next_due:
                # Belt and braces. poll_account already contains its own
                # failures; this is here so that no future edit inside it can
                # take the process down and stop every *other* account too. The
                # per-account backoff still decides when this one is retried.
                try:
                    poll_account(account, interval)
                except Exception as e:
                    print(f"kclaude-daemon: {account.label}: unhandled error in poll ({e})",
                          file=sys.stderr)
                    account.backoff = min(account.backoff * 2, MAX_BACKOFF)
                    account.wake_floor = account.backoff
                    account.next_due = time.monotonic() + account.backoff
        # Jitter avoids lockstep retries across restarts. Per account, and folded
        # into each one's own schedule rather than added to the sleep: adding it
        # here made every effective interval 60-75s instead of the 60s the
        # README and the settings page both promise.
        woke = waker.wait(seconds_until_next(accounts))

        if signal.SIGUSR2 in woke:
            # The widget saw a five-hour window run out and wants the next one
            # opened now.
            prime_due_accounts(accounts)
        if signal.SIGUSR1 in woke:
            request_poll(accounts)


def selftest():
    global STATE_DIR, LOCK_FILE, ACCOUNTS_FILE, CLAUDE_VERSIONS_DIR

    @contextlib.contextmanager
    def quiet():
        """Swallow the collector's own journal output for the duration.

        Several cases below drive reload and scheduling paths that log on every
        call, and the point of the selftest is the last line, not the noise in
        front of it.
        """
        with contextlib.redirect_stderr(io.StringIO()) as buf:
            yield buf

    assert normalize_windows({"five_hour": {"utilization": 68, "resets_at": "T"}}) == {
        "five_hour": {"utilization": 0.68, "resetAt": "T"}
    }
    # Missing, null and non-dict windows are dropped rather than written as 0%.
    assert normalize_windows({"five_hour": {"utilization": None}, "seven_day": None}) == {}
    assert normalize_windows({}) == {}

    # --- the shared id table -------------------------------------------------
    #
    # tests/fixtures/slugs.json is read by this and by tests/accounts.test.js, so
    # what is pinned is that the two implementations of the id rule *agree*.
    # Each was previously tested against itself, which is the one direction in
    # which they can diverge: Python's str.isalnum() is Unicode-aware and the JS
    # regex is not, so "café" became "café" here and "caf" there and the widget
    # watched a file the collector never wrote. Nothing was red.
    slug_fixture = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                os.pardir, "tests", "fixtures", "slugs.json")
    if os.path.exists(slug_fixture):
        with open(slug_fixture) as f:
            slugs = json.load(f)
        assert slugs["maxLength"] == MAX_ID_LENGTH, (slugs["maxLength"], MAX_ID_LENGTH)
        for case in slugs["cases"]:
            got = account_id(case["in"])
            assert got == case["out"], (case["in"], got, case["out"])
            # The id is part of a filename, so it must fit one. 11 bytes of
            # affix plus a 255-byte NAME_MAX is the hard ceiling; the cap here
            # is well inside it and the same on the other side.
            assert len(got.encode()) <= 244, (case["in"], got)
        for value in slugs["nonStrings"]:
            # Not coerced. A number is not an id, and inventing one here would
            # put a row on the panel the other half has dropped.
            assert account_id(value) == "", (value, account_id(value))
    else:
        raise AssertionError(f"the shared id table is missing: {slug_fixture}")

    # The cap exists because an over-long id produced a filename past NAME_MAX,
    # after which every write for that account failed with ENAMETOOLONG and the
    # poll's backoff turned that into "this account silently shows nothing for
    # ever" with one line in the journal.
    assert len(account_id("a" * 5000)) == MAX_ID_LENGTH
    assert account_id("café") == "caf", account_id("café")
    assert account_id("клиент") == "", account_id("клиент")

    assert token_expired({"expiresAt": 0})
    assert not token_expired({"expiresAt": (time.time() + 3600) * 1000})
    assert not token_expired({})  # unknown expiry -> let the 401 path handle it

    assert parse_interval(["x"]) == DEFAULT_INTERVAL
    assert parse_interval(["x", "5"]) == MIN_INTERVAL  # clamped up
    assert parse_interval(["x", "900"]) == 900

    # The priming request is unusual enough to pin: /v1/messages rejects an
    # OAuth bearer token outright without the beta opt-in, and (empirically --
    # see PRIME_SYSTEM) without the Claude Code system prompt. A silently
    # malformed body would just look like the window refusing to open.
    # Nothing but a subscription token may be spent. An API key here would bill
    # prepaid credits, so it has to be a hard refusal, not a warning.
    for rejected in ("sk-ant-api03-xxxx", "sk-ant-", "", None, 42):
        try:
            prime_request(rejected)
            raise SystemExit(f"selftest: prime_request accepted {rejected!r}")
        except AuthError:
            pass

    primer = prime_request("sk-ant-oat01-tok")
    assert primer.full_url == MESSAGES_URL
    assert primer.get_header("X-api-key") is None
    assert primer.get_method() == "POST"
    assert primer.get_header("Authorization") == "Bearer sk-ant-oat01-tok"
    assert primer.get_header("Anthropic-beta") == OAUTH_BETA
    assert primer.get_header("Anthropic-version") == "2023-06-01"
    # claude-cli's identity, deliberately. Shape matters more than the version:
    # the endpoints only serve this client.
    assert primer.get_header("User-agent") == f"claude-cli/{CLI_VERSION} (external, cli)"
    assert primer.get_header("X-app") == "cli"
    assert primer.get_header("X-claude-code-session-id") == SESSION_ID
    # Numeric, not lexicographic: 220 > 99.
    with tempfile.TemporaryDirectory() as d:
        for name in ("2.1.99", "2.1.220", "notaversion"):
            os.mkdir(os.path.join(d, name))
        CLAUDE_VERSIONS_DIR = d
        assert claude_cli_version() == "2.1.220"
        CLAUDE_VERSIONS_DIR = os.path.join(d, "missing")
        assert claude_cli_version() == CLAUDE_VERSION_FALLBACK
    body = json.loads(primer.data)
    assert body["system"].startswith("You are Claude Code"), body
    assert body["messages"] == [{"role": "user", "content": PRIME_TEXT}], body
    # Exactly 1, not 0: a zero-token request generates nothing, and the whole
    # point is that a completion happened. See PRIME_MAX_TOKENS.
    assert body["max_tokens"] == 1, body

    # The ping goes through the same allowlist: it spends too, just barely.
    for rejected in ("sk-ant-api03-xxxx", "", None):
        try:
            ping_request(rejected)
            raise SystemExit(f"selftest: ping_request accepted {rejected!r}")
        except AuthError:
            pass
    ping_body = json.loads(ping_request("sk-ant-oat01-tok").data)
    # No system prompt: it is the whole difference between 22 tokens and 8.
    assert "system" not in ping_body, ping_body
    assert ping_body["max_tokens"] == PING_MAX_TOKENS, ping_body

    # Headers in, endpoint shape out, so normalize_windows stays the only place
    # that knows the widget's units.
    assert normalize_windows(usage_from_headers({
        "anthropic-ratelimit-unified-5h-utilization": "0.62",
        "anthropic-ratelimit-unified-5h-reset": "1785388800",
        "anthropic-ratelimit-unified-7d-utilization": "0.47",
        "anthropic-ratelimit-unified-7d-reset": "1785754800",
    })) == {
        "five_hour": {"utilization": 0.62, "resetAt": "2026-07-30T05:20:00Z"},
        "seven_day": {"utilization": 0.47, "resetAt": "2026-08-03T11:00:00Z"},
    }
    # A reply without the headers yields nothing, which write_usage rejects
    # rather than writing 0% over good numbers.
    assert usage_from_headers({}) == {}
    assert usage_from_headers({"anthropic-ratelimit-unified-5h-utilization": "0.5"}) == {}

    # The one that motivated generic handling: a boolean is an int in Python, and
    # utilization: true must not become 1%.
    assert normalize_window({"utilization": True}) is None
    assert normalize_window({"utilization": 50}) == {"utilization": 0.5, "resetAt": None}
    assert normalize_window(None) is None
    assert normalize_window({"utilization": "50"}) is None

    # Fable's weekly budget rides on limits[] and on nothing else. This is the
    # live shape from a Max-plan account (2026-09-27), trimmed to the fields the
    # reader uses.
    scoped_payload = {"limits": [
        {"kind": "session", "group": "session", "percent": 82,
         "resets_at": "2026-09-27T16:29:59.622488+00:00", "scope": None},
        {"kind": "weekly_all", "group": "weekly", "percent": 11,
         "resets_at": "2026-09-29T19:59:59.622513+00:00", "scope": None},
        {"kind": "weekly_scoped", "group": "weekly", "percent": 22,
         "resets_at": "2026-09-29T19:59:59.622752+00:00",
         "scope": {"model": {"id": None, "display_name": "Fable"}, "surface": None}},
    ]}
    assert scoped_windows(scoped_payload) == {
        "fable": {"utilization": 22, "resets_at": "2026-09-29T19:59:59.622752+00:00"}
    }
    # An account without Fable reports no scoped limit at all, and that has to
    # read as "none" rather than as a parse failure.
    assert scoped_windows({"limits": scoped_payload["limits"][:2]}) == {}
    assert scoped_windows({}) == {}
    assert scoped_windows({"limits": None}) == {}
    assert scoped_windows(None) == {}
    # A scoped limit with nothing usable in it, or no model to name it after, is
    # dropped rather than shown as a nameless or unmeasured bar.
    assert scoped_windows({"limits": [
        {"kind": "weekly_scoped", "percent": 10, "resets_at": "T", "scope": None}]}) == {}
    assert scoped_windows({"limits": [
        {"kind": "weekly_scoped", "percent": 10, "resets_at": "T", "scope": {}}]}) == {}
    assert scoped_windows({"limits": [
        {"kind": "weekly_scoped", "percent": 10, "resets_at": "T",
         "scope": {"model": {}}}]}) == {}
    assert scoped_windows({"limits": [
        {"kind": "weekly_scoped", "percent": 10, "resets_at": "T",
         "scope": {"model": {"display_name": "   "}}}]}) == {}
    assert scoped_windows({"limits": [
        {"kind": "weekly_scoped", "resets_at": "T",
         "scope": {"model": {"display_name": "Fable"}}}]}) == {}
    # A different kind of limit is not this function's business.
    assert scoped_windows({"limits": [
        {"kind": "weekly_all", "percent": 10, "resets_at": "T", "scope": None}]}) == {}
    # Any other model family keeps working: the id is derived, not enumerated,
    # so a second scoped limit needs no code change here.
    assert list(scoped_windows({"limits": [
        {"kind": "weekly_scoped", "percent": 5, "resets_at": "T",
         "scope": {"model": {"display_name": "Opus 4.6"}}}]})) == ["opus_4_6"]
    # The endpoint's long tail of sibling keys must not leak into the file as
    # windows: normalize_windows is an allowlist, deliberately.
    assert set(normalize_windows({
        "five_hour": {"utilization": 82, "resets_at": "T"},
        "nimbus_quill": {"utilization": 0, "resets_at": None},
        "seven_day_opus": None,
    })) == {"five_hour"}

    # The scoped cache, end to end against a real file.
    with tempfile.TemporaryDirectory() as d:
        sc_path = os.path.join(d, "scoped.json")
        now = time.time()

        calls = []
        def fake_fetch(_account):
            calls.append(1)
            return scoped_payload
        # No account attached: this block is about the cache itself, and an
        # account is what carries the plan the skip below keys off.
        sc = ScopedWindows(sc_path)
        # Cold: no window yet, and one due because nothing has been fetched.
        assert not sc._windows
        assert sc.due(now)
        assert sc.refresh(fake_fetch)
        assert len(calls) == 1
        assert not sc.due(now), "one call must not buy a second one"
        assert not sc.refresh(fake_fetch)
        assert len(calls) == 1, "not due -> no request at all"

        # The merge keeps its own timestamp, because it really is older, and
        # never displaces a window the poll reports itself.
        polled = normalize_windows({"five_hour": {"utilization": 82, "resets_at": "P"},
                                    "fable": {"utilization": 99, "resets_at": "Q"}})
        merged = sc.apply(polled)
        assert set(merged) == {"five_hour", "fable"}
        assert merged["five_hour"] == {"utilization": 0.82, "resetAt": "P"}
        assert "updatedAt" not in merged["five_hour"]
        assert merged["fable"] == {"utilization": 0.22,
                                   "resetAt": "2026-09-29T19:59:59.622752+00:00",
                                   "updatedAt": iso(sc._fetched_at)}
        assert sc.apply({})["fable"]["utilization"] == 0.22

        # A spent Fable budget is invisible to the poll and refuses the same
        # requests, so it has to quiet the daemon on its own.
        assert sc.exhausted_until(time.time()) is None
        sc._windows = {"fable": {"utilization": 100,
                                 "resets_at": "2026-09-29T19:59:59.622752+00:00"}}
        # 6-digit fractional seconds and a +00:00 offset: the endpoint's own
        # shape. The point of the bound is that the answer is the real wait and
        # not the MAX_BACKOFF fallback -- a fromisoformat that could not read
        # this shape would return exactly MAX_BACKOFF, and the daemon would then
        # poll a spent weekly budget once an hour instead of waiting it out.
        spent_fable = sc.exhausted_until(
            datetime.datetime.fromisoformat("2026-09-29T19:00:00+00:00").timestamp())
        assert MAX_BACKOFF < spent_fable < MAX_BACKOFF + 60, spent_fable
        sc._windows = {"fable": {"utilization": 99.9, "resets_at": "T"}}
        assert sc.exhausted_until(time.time()) is None
        sc._windows = {"fable": {"utilization": 22,
                                 "resets_at": "2026-09-29T19:59:59.622752+00:00"}}

        # Persisted, so a restart does not spend a call the last one earned.
        revived = ScopedWindows(sc_path)
        assert revived._windows == sc._windows
        assert revived._fetched_at == sc._fetched_at
        assert not revived.due(now)
        assert revived.apply({})["fable"]["utilization"] == 0.22

        # A failure backs off instead of retrying into the wall, and never
        # raises into the poll loop. Each clock is snapshotted: reading
        # sc._next_attempt live would always answer "due".
        real_now = time.time
        try:
            boundary = sc._next_attempt
            time.time = lambda: boundary
            assert sc.due(), "due exactly at the boundary"
            assert not sc.refresh(lambda _a: (_ for _ in ()).throw(RuntimeError("429")))
            assert len(calls) == 1, "a failed refresh must not retry inline"
            assert not sc.due(), "a failure must push the next attempt out"
            # Doubled, so it takes two intervals before the next try.
            assert sc._next_attempt >= boundary + SCOPED_INTERVAL
            retry_at = sc._next_attempt
            time.time = lambda: retry_at
            assert sc.due()
            assert sc.refresh(fake_fetch)
            assert len(calls) == 2
            assert not sc.due(), "a success resets the interval, it does not reset the clock"
        finally:
            time.time = real_now

        # A plan downgrade: the endpoint stops reporting the window, and the
        # phantom has to go rather than sit on the panel forever.
        downgrade_at = sc._next_attempt
        time.time = lambda: downgrade_at
        assert sc.refresh(lambda _a: {"limits": []})
        assert sc._windows == {}
        assert sc.apply(normalize_windows({"five_hour": {"utilization": 1, "resets_at": "T"}})) \
            == {"five_hour": {"utilization": 0.01, "resetAt": "T"}}

        # Garbage on disk reads as "never fetched", not as a crash.
        write_atomic(sc_path, "not json", mode=0o600)
        assert ScopedWindows(sc_path)._windows == {}
        write_atomic(sc_path, json.dumps({"windows": {}, "fetchedAt": "soon"}), mode=0o600)
        assert ScopedWindows(sc_path)._fetched_at == 0.0
        assert os.stat(sc_path).st_mode & 0o777 == 0o600

    # prime_session hands back the headers its own reply carried, so opening a
    # window can update the numbers without spending a second request. What has
    # to hold is that the reply's headers read as a normal poll.
    class FakeReply:
