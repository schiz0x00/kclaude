        assert collect(any_account)["five_hour"]["utilization"] == 70  # ping wins
        assert not endpoint_calls
        ping_usage = lambda _a: {}  # 200, but the headers are gone
        assert collect(any_account)["five_hour"]["utilization"] == 5
        def boom(_a):
            raise RuntimeError("model retired")
        ping_usage = boom
        assert collect(any_account)["five_hour"]["utilization"] == 5
        def expired(_a):
            raise AuthError("login expired")
        ping_usage = expired
