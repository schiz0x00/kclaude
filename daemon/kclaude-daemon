    # comparison against NaN is False, so `utilization < 100.0` alone treated a
    # NaN window as spent and put the account to sleep for the whole window, with
    # a wake_floor a manual Refresh could not pull it out of.
    for bad in (float("nan"), float("inf"), float("-inf")):
        assert exhausted_until({"five_hour": {"utilization": bad,
                                              "resets_at": "2026-07-30T05:20:00Z"}},
                               now) is None, bad
    # ...and the same value must never reach the file, where json.dumps writes a
    # bare NaN token that is not JSON and that QML's JSON.parse rejects.
    assert normalize_window({"utilization": float("nan"), "resets_at": "T"}) is None
    assert normalize_window({"utilization": float("inf"), "resets_at": "T"}) is None
    # Out of contract on the other side too: a bar pinned at full beside a label
    # reading "550%" is the widget drawing two things that disagree.
    assert normalize_window({"utilization": 550, "resets_at": "T"})["utilization"] == 1.0
    assert normalize_window({"utilization": -5, "resets_at": "T"})["utilization"] == 0.0
    # bool is an int subclass, and utilization: true is not a percentage.
    assert normalize_window({"utilization": True, "resets_at": "T"}) is None

    # iso() is total. Every caller parses a response nobody promised was well
    # formed, and an OverflowError here took the whole poll down instead of
    # dropping the one field that was wrong.
    assert iso(float("nan")) is None
    assert iso(1e300) is None
    assert iso("not a number") is None
    assert iso(0).endswith("Z")

    # parse_iso() exists so the daemon's own "Z" output is readable on every
    # supported interpreter. datetime.fromisoformat only learned the trailing Z
    # in 3.11, and on anything older every reset time here failed to parse --
    # silently, because the failure is swallowed -- degrading the entire
    # go-quiet-until-reset design into a flat one-hour backoff.
    assert parse_iso("2026-07-30T05:20:00Z") == now + 20 * 60
    assert parse_iso("2026-07-30T05:20:00+00:00") == now + 20 * 60
    # A value with no offset is read as UTC, matching iso()'s output.
    assert parse_iso("2026-07-30T05:20:00") == now + 20 * 60
    # The scoped endpoint's own form, with six fractional digits.
    assert parse_iso("2026-09-29T19:59:59.622752+00:00") is not None
    for bad in (None, "", "T", 42, "2026-13-45T99:99:99Z"):
        assert parse_iso(bad) is None, bad

