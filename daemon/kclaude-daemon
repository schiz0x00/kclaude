    assert "five_hour" in fractional, fractional
    assert fractional["five_hour"]["utilization"] == 50.0, fractional
    # The reverse: a reset that will not parse drops that field, not the window.
    assert usage_from_headers({
        "anthropic-ratelimit-unified-5h-utilization": "0.5",
        "anthropic-ratelimit-unified-5h-reset": "not-a-number",
    }) == {}
    # Non-finite utilization is refused here rather than at json.dumps, where it
    # would become a token the widget's parser rejects.
    assert usage_from_headers({
        "anthropic-ratelimit-unified-5h-utilization": "nan",
        "anthropic-ratelimit-unified-5h-reset": "1759000000",
    }) == {}
    assert usage_from_headers({
        "anthropic-ratelimit-unified-5h-utilization": "inf",
        "anthropic-ratelimit-unified-5h-reset": "1759000000",
