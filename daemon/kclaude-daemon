    # no headers raises nothing, so without the check collect() would hand
    # write_usage an empty dict and the daemon would back off forever.
    global ping_usage, get_usage
    real_ping, real_endpoint = ping_usage, get_usage
    endpoint_calls = []
    any_account = default_account()
    get_usage = lambda _a: (endpoint_calls.append(1),
