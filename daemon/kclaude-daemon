#!/usr/bin/env python3
"""Polls the Claude account usage endpoint and writes usage.json for the plasmoid.

Reads the OAuth token Claude Code stores in ~/.claude/.credentials.json, and
writes a refreshed token back when it expires. See the Security section of the
README: this daemon shares a credential file it does not own.
"""
import contextlib
import fcntl
import json
import os
import random
import select
import signal
import sys
import tempfile
import time
import urllib.error
import urllib.request

STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "kclaude")
USAGE_FILE = os.path.join(STATE_DIR, "usage.json")
LOCK_FILE = os.path.join(STATE_DIR, "daemon.lock")
PRIME_STAMP_FILE = os.path.join(STATE_DIR, "last-prime")
CREDENTIALS_FILE = os.path.expanduser("~/.claude/.credentials.json")

TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
MESSAGES_URL = "https://api.anthropic.com/v1/messages"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"

# Session priming: one throwaway message, sent to open the next five-hour
# window at the moment the previous one expires.
#
# The cheapest model there is. Pinned to the dated id rather than the
# "claude-haiku-4-5" alias on purpose: an alias that moves under us would change
# what this spends without the change showing up in a diff. Retirement shows up
# as a 404 in the journal, which is the failure we would rather have.
# ponytail: assumes any model opens the five-hour window. If a Haiku call turns
# out not to start it, switch to "claude-sonnet-4-5".
PRIME_MODEL = "claude-haiku-4-5-20251001"
PRIME_TEXT = "hi"
# max_tokens 1, deliberately not 0. A zero-token request is the documented way to
# run prefill *without* generating anything -- which is the opposite of what this
# needs. The window has to see a real completion, and one Haiku output token
# costs about five millionths of a dollar, so there is nothing here worth saving.
PRIME_MAX_TOKENS = 1
# Documented: /v1/messages rejects an OAuth bearer token outright without this
# beta opt-in.
OAUTH_BETA = "oauth-2025-04-20"
# NOT documented: the endpoint also appears to reject an OAuth token unless the
# system prompt identifies the caller as Claude Code. Determined empirically
# (2026-07), not from any published contract -- so treat a sudden 400 here as
# this having changed, and re-check before assuming the token itself is bad.
PRIME_SYSTEM = "You are Claude Code, Anthropic's official CLI for Claude."
# Truthful rather than an imitation of claude-cli's. Reusing Claude Code's OAuth
# client id is already the outer limit of what this should do; forging its
# user-agent on top would also rot the moment claude-cli's version string moves.
USER_AGENT = "kclaude-daemon (+https://github.com/schiz0x00/kclaude)"
# Priming is the only thing here that spends anything, so it is the only thing
# that has to be sure *what* it spends. A Claude Code OAuth access token
# ("sk-ant-oat01-") draws on the subscription; an API key ("sk-ant-api03-")
# draws on prepaid API credits, i.e. real money, and must never be used here.
# An allowlist, not a denylist: an unrecognised credential refuses to prime
# rather than guessing which account pays.
OAUTH_TOKEN_PREFIX = "sk-ant-oat"

# The endpoint rate-limits well below one call every 30s. The widget treats data
# older than 15 minutes as stale, so 5 minutes leaves a 3x margin.
DEFAULT_INTERVAL = 300
MIN_INTERVAL = 60
MAX_BACKOFF = 3600
# A held-down Refresh button must not turn into an API hammer. The usage
# endpoint returns 429 well below one call every 30s, so this is the floor for
# manually requested polls, not a nicety.
MIN_POLL_GAP = 30
# Priming spends quota, so the floor matters more than it does for a poll. One
# five-hour window can only need one prime; an hourly ceiling means a widget
# stuck in a loop costs one tiny message an hour instead of thousands. Kept on
# disk rather than in memory, so a restart loop cannot reset it either.
MIN_PRIME_GAP = 3600
# Refresh the token this long before it actually expires.
TOKEN_SKEW_MS = 5 * 60 * 1000

WINDOW_KEYS = ("five_hour", "seven_day", "thirty_day")


class AuthError(Exception):
    """The credentials are gone or rejected: waiting will not fix it, only the
    user re-authenticating Claude Code will. Surfaced to the widget via the
    "error" key in usage.json, and retried gently in case they just did."""


def write_atomic(path, text, mode=0o644):
    """Write via temp file + rename so readers never observe a partial file."""
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            # chmod before the content lands, so the file is never briefly readable.
            os.fchmod(f.fileno(), mode)
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        # suppress: never let cleanup replace the original traceback.
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def single_instance_lock():
    """Return a held lock fd, or None if another daemon already has it.

    Two daemons refreshing concurrently both rotate the refresh token. The loser
    then writes a server-invalidated token into ~/.claude/.credentials.json and
    Claude Code itself has to re-authenticate. Refusing to start twice is worth
    more than the convenience of a second instance.
    """
    os.makedirs(STATE_DIR, exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    # Held for the process lifetime; closing the fd would release it.
    return fd


class Waker:
    """Lets a signal cut the poll interval short: SIGUSR1 to poll now (the
    widget's Refresh button), SIGUSR2 to open a new five-hour window.

    Uses set_wakeup_fd + select rather than a flag checked around time.sleep:
    PEP 475 makes time.sleep resume after a handler returns, and touching a lock
    from inside a handler can deadlock against the code it interrupted.
    """

    SIGNALS = (signal.SIGUSR1, signal.SIGUSR2)

    def __init__(self):
        self._r, self._w = os.pipe()
        os.set_blocking(self._r, False)
        os.set_blocking(self._w, False)
        signal.set_wakeup_fd(self._w)
        for sig in self.SIGNALS:
            # A Python-level handler has to exist or the signal keeps its default
            # action, which is to kill the process.
            signal.signal(sig, lambda *_: None)

    def wait(self, seconds):
        """Sleep up to `seconds`. Returns the signal numbers that arrived, as a
        set, empty if the wait simply ran out."""
        deadline = time.monotonic() + seconds
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return frozenset()
            try:
                ready, _, _ = select.select([self._r], [], [], remaining)
            except InterruptedError:
                continue
            if not ready:
                return frozenset()
            # set_wakeup_fd writes one byte per signal: the signal number. Both
            # can be pending at once, so read the lot and report all of them.
            try:
                return frozenset(os.read(self._r, 4096))
            except BlockingIOError:
                # select() said readable but the read would block: a spurious
                # wake, not a signal. Returning an empty set here would be
                # indistinguishable from the wait running out, and the caller
                # paces on exactly that difference -- keep waiting instead.
                continue


def load_credentials():
    with open(CREDENTIALS_FILE) as f:
        return json.load(f)


def save_oauth(oauth):
    """Merge the refreshed token back, re-reading the file first.

    Claude Code owns this file and updates sibling keys (mcpOAuth,
    organizationUuid) on its own schedule. Re-reading immediately before the
    write shrinks the lost-update window from a whole poll interval to
    microseconds. It cannot close it -- Claude Code does not take our lock -- so
    only the one key we actually changed is written back.
    """
    try:
        creds = load_credentials()
    except (OSError, ValueError):
        creds = {}
    creds["claudeAiOauth"] = oauth
    # 0600: the file holds live OAuth tokens.
    write_atomic(CREDENTIALS_FILE, json.dumps(creds, indent=2), mode=0o600)


def refresh_access_token(oauth):
    """Exchange the refresh token. The server rotates it, so persist at once."""
    body = json.dumps({
        "grant_type": "refresh_token",
        "refresh_token": oauth["refreshToken"],
        "client_id": CLIENT_ID,
    }).encode()
    req = urllib.request.Request(TOKEN_URL, data=body, headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        # 400 is what an invalid/rotated-away refresh token actually returns
        # (invalid_grant). 5xx and network errors stay retryable errors.
        if e.code in (400, 401, 403):
            raise AuthError("Claude Code login expired: run 'claude' and sign in again") from e
        raise
    oauth["accessToken"] = data["access_token"]
    if "refresh_token" in data:
        oauth["refreshToken"] = data["refresh_token"]
    if "expires_in" in data:
        oauth["expiresAt"] = int(time.time() * 1000) + data["expires_in"] * 1000
    save_oauth(oauth)
    return oauth["accessToken"]


def token_expired(oauth):
    expires_at = oauth.get("expiresAt")
    if not isinstance(expires_at, (int, float)):
        return False  # unknown expiry -> let the 401 path handle it
    return time.time() * 1000 >= expires_at - TOKEN_SKEW_MS


def fetch_usage(access_token):
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": f"Bearer {access_token}",
        "anthropic-version": "2023-06-01",
        "Content-Type": "application/json",
    })
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)


def with_token(call):
    """Run call(access_token), refreshing the token once if it is rejected.

    Every authenticated request goes through here, so the refresh-on-401 rule
    cannot be forgotten by a new caller.
    """
    try:
        oauth = load_credentials()["claudeAiOauth"]
    except FileNotFoundError:
        raise AuthError("No Claude Code credentials found: run 'claude' and sign in") from None
    except (KeyError, ValueError):
        raise AuthError("Credentials file has no Claude Code OAuth entry: run 'claude' and sign in") from None
    # Refresh up front when the token is known-expired, instead of burning a
    # request to discover it.
    access_token = refresh_access_token(oauth) if token_expired(oauth) else oauth["accessToken"]
    try:
        return call(access_token)
    except urllib.error.HTTPError as e:
        if e.code != 401:
            raise
        return call(refresh_access_token(oauth))


def get_usage():
    return with_token(fetch_usage)


def prime_request(access_token):
    """The priming request, built but not sent, so a test can inspect it.

    Authorization is the OAuth bearer token and nothing else: no x-api-key
    header, and no ANTHROPIC_API_KEY is read anywhere in this file, so there is
    no path by which this request reaches API billing.
    """
    if not isinstance(access_token, str) or not access_token.startswith(OAUTH_TOKEN_PREFIX):
        raise AuthError(
            "refusing to prime: the credential is not a Claude Code OAuth token "
            f"(expected {OAUTH_TOKEN_PREFIX}...), and priming must only ever spend "
            "subscription usage")
    body = json.dumps({
        "model": PRIME_MODEL,
        "max_tokens": PRIME_MAX_TOKENS,
        "system": PRIME_SYSTEM,
        "messages": [{"role": "user", "content": PRIME_TEXT}],
    }).encode()
    return urllib.request.Request(MESSAGES_URL, data=body, method="POST", headers={
        "Authorization": f"Bearer {access_token}",
        "anthropic-version": "2023-06-01",
        "anthropic-beta": OAUTH_BETA,
        "Content-Type": "application/json",
        "User-Agent": USER_AGENT,
    })


def last_prime_at():
    """When the last prime went out, as a wall-clock epoch.

    Wall clock rather than monotonic because this has to survive a restart:
    an in-memory counter would let a crash-restart loop spend once per crash,
    which is exactly the case MIN_PRIME_GAP exists to bound.
    """
    try:
        with open(PRIME_STAMP_FILE) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return float("-inf")


def record_prime(when=None):
    write_atomic(PRIME_STAMP_FILE, str(time.time() if when is None else when), mode=0o600)


def prime_gap_elapsed():
    """True if enough time has passed since the last prime.

    A stamp in the future means the clock moved backwards (an NTP step, a
    suspend). Treat that as unknown and allow, rather than locking priming out
    until the clock catches up.
    """
    since = time.time() - last_prime_at()
    return not (0 <= since < MIN_PRIME_GAP), since


def prime_session():
    """Send one message, so the five-hour window starts now.

    Costs a sliver of the quota this daemon exists to watch. That is the trade
    the setting is there to make: the window opens on a schedule the user picked
    instead of whenever they happen to type something.
    """
    def send(access_token):
        with urllib.request.urlopen(prime_request(access_token), timeout=30) as resp:
            return json.load(resp)

    reply = with_token(send)
    # Stamp only once the request came back: a failed prime must not consume the
    # hourly allowance, or one outage would suppress the next real attempt too.
    record_prime()
    # The reply is discarded, but its model confirms the request was really
    # served rather than answered from some cache or proxy.
    print(f"kclaude-daemon: session primed ({reply.get('model', 'unknown model')})", file=sys.stderr)


def normalize_windows(raw):
    """API percentages (0-100) -> the widget's 0.0-1.0 model."""
    windows = {}
    for key in WINDOW_KEYS:
        window = raw.get(key)
        if not isinstance(window, dict):
            continue
        utilization = window.get("utilization")
        if not isinstance(utilization, (int, float)):
            continue
        windows[key] = {
            "utilization": utilization / 100.0,
            "resetAt": window.get("resets_at"),
        }
    return windows


def write_usage(raw):
    windows = normalize_windows(raw)
    if not windows:
        raise ValueError(f"no usable windows in response (keys: {sorted(raw)})")
    payload = {
        "windows": windows,
        "updatedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    write_atomic(USAGE_FILE, json.dumps(payload, indent=4))


def write_error(message):
    """Put an auth problem in usage.json without discarding the last good
    numbers: the widget keeps showing them (as stale) alongside the message.
    A successful poll rewrites the file without the key, clearing it."""
    try:
        with open(USAGE_FILE) as f:
            payload = json.load(f)
        if not isinstance(payload, dict):
            payload = {}
    except (OSError, ValueError):
        payload = {}
    payload.setdefault("windows", {})
    payload.setdefault("updatedAt", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    payload["error"] = message
    write_atomic(USAGE_FILE, json.dumps(payload, indent=4))


def retry_after(error, fallback):
    """Honour Retry-After on 429/503 when the server supplies one."""
    try:
        # Capped: a bogus or hostile header must not park the daemon for a week.
        return min(MAX_BACKOFF, max(fallback, int(error.headers.get("Retry-After"))))
    except (AttributeError, TypeError, ValueError):
        return fallback


def parse_interval(argv):
    if len(argv) <= 1:
        return DEFAULT_INTERVAL
    try:
        return max(MIN_INTERVAL, int(argv[1]))
    except ValueError:
        raise SystemExit(f"kclaude-daemon: interval must be a whole number of seconds, got {argv[1]!r}")


def main():
    interval = parse_interval(sys.argv)
    if single_instance_lock() is None:
        # Exit 0: this is the expected outcome of starting a second copy, not a
        # failure for systemd to restart in a loop.
        print("kclaude-daemon: another instance is already running, exiting", file=sys.stderr)
        return
    waker = Waker()
    backoff = interval
    last_poll = 0.0
    while True:
        last_poll = time.monotonic()
        try:
            write_usage(get_usage())
            backoff = interval
            delay = interval
            wake_floor = MIN_POLL_GAP
        except AuthError as e:
            print(f"kclaude-daemon: {e}", file=sys.stderr)
            write_error(str(e))
            delay = backoff
            backoff = min(backoff * 2, MAX_BACKOFF)
            # The user's next move is re-authenticating and hitting Refresh, so
            # unlike the generic backoff below, let a manual poll through at the
            # normal pace. If they have not re-authed yet it costs one token
            # request per click, floored at MIN_POLL_GAP.
            wake_floor = MIN_POLL_GAP
        except Exception as e:
            print(f"kclaude-daemon: {e}", file=sys.stderr)
            # Exponential backoff so a rate limit or an outage is not hammered.
            delay = retry_after(e, backoff)
            backoff = min(backoff * 2, MAX_BACKOFF)
            # While backing off, a refresh request must not short-circuit the
            # wait: that is exactly how one 429 becomes a hammer.
            wake_floor = delay
        # Jitter avoids lockstep retries across restarts.
        woke = waker.wait(delay + random.uniform(0, min(15, delay * 0.1)))

        if signal.SIGUSR2 in woke:
            # The widget saw the five-hour window run out and wants the next one
            # opened now.
            elapsed, since_prime = prime_gap_elapsed()
            if not elapsed:
                print(f"kclaude-daemon: prime requested, refused: only "
                      f"{since_prime / 60:.0f}m since the last one", file=sys.stderr)
            else:
                try:
                    prime_session()
                except Exception as e:
                    # A failed prime must not disturb the poll loop: the widget
                    # keeps working, and the reason is in the journal.
                    print(f"kclaude-daemon: prime failed: {e}", file=sys.stderr)

        if signal.SIGUSR1 in woke:
            # A manual refresh that did nothing is worth being able to see.
            print("kclaude-daemon: poll requested", file=sys.stderr)

        # Every branch above falls through to the top of the loop, which polls
        # straight away -- so the floor belongs here, once, rather than in the
        # branch that happens to have remembered it. A prime that was refused or
        # that failed must not become a way around the pacing a refresh gets, and
        # during an error backoff wake_floor is the whole backoff, so no signal
        # can short-circuit it. A prime that succeeded lands here too: the
        # numbers on screen are stale until the next poll, but the poll that
        # opened this wait can be seconds old, and that is exactly how an
        # immediate re-poll earns a 429 and doubles the backoff for no reason.
        if woke:
            since = time.monotonic() - last_poll
            if since < wake_floor:
                print(f"kclaude-daemon: pacing {wake_floor - since:.0f}s", file=sys.stderr)
                time.sleep(wake_floor - since)


def selftest():
    global CREDENTIALS_FILE, STATE_DIR, LOCK_FILE, PRIME_STAMP_FILE

    assert normalize_windows({"five_hour": {"utilization": 68, "resets_at": "T"}}) == {
        "five_hour": {"utilization": 0.68, "resetAt": "T"}
    }
    # Missing, null and non-dict windows are dropped rather than written as 0%.
    assert normalize_windows({"five_hour": {"utilization": None}, "seven_day": None}) == {}
    assert normalize_windows({}) == {}
    assert token_expired({"expiresAt": 0})
    assert not token_expired({"expiresAt": (time.time() + 3600) * 1000})
    assert not token_expired({})  # unknown expiry -> let the 401 path handle it

    assert parse_interval(["x"]) == DEFAULT_INTERVAL
    assert parse_interval(["x", "5"]) == MIN_INTERVAL  # clamped up
    assert parse_interval(["x", "900"]) == 900

    # The priming request is unusual enough to pin: /v1/messages rejects an
    # OAuth bearer token outright without the beta opt-in, and (empirically --
    # see PRIME_SYSTEM) without the Claude Code system prompt. A silently
    # malformed body would just look like the window refusing to open.
    # Nothing but a subscription token may be spent. An API key here would bill
    # prepaid credits, so it has to be a hard refusal, not a warning.
    for rejected in ("sk-ant-api03-xxxx", "sk-ant-", "", None, 42):
        try:
            prime_request(rejected)
            raise SystemExit(f"selftest: prime_request accepted {rejected!r}")
        except AuthError:
            pass

    primer = prime_request("sk-ant-oat01-tok")
    assert primer.full_url == MESSAGES_URL
    assert primer.get_header("X-api-key") is None
    assert primer.get_method() == "POST"
    assert primer.get_header("Authorization") == "Bearer sk-ant-oat01-tok"
    assert primer.get_header("Anthropic-beta") == OAUTH_BETA
    assert primer.get_header("Anthropic-version") == "2023-06-01"
    # Says what it is rather than imitating claude-cli. If this ever has to
    # change to get served, that is a finding worth noticing, not a silent tweak.
    assert primer.get_header("User-agent") == USER_AGENT
    body = json.loads(primer.data)
    assert body["system"].startswith("You are Claude Code"), body
    assert body["messages"] == [{"role": "user", "content": PRIME_TEXT}], body
    # Exactly 1, not 0: a zero-token request generates nothing, and the whole
    # point is that a completion happened. See PRIME_MAX_TOKENS.
    assert body["max_tokens"] == 1, body

    class FakeErr:
        headers = {"Retry-After": "120"}
    assert retry_after(FakeErr(), 60) == 120
    assert retry_after(FakeErr(), 300) == 300  # never shorter than our backoff
    FakeErr.headers = {"Retry-After": "999999"}
    assert retry_after(FakeErr(), 60) == MAX_BACKOFF  # capped
    FakeErr.headers = {"Retry-After": "Wed, 21 Oct 2026 07:28:00 GMT"}
    assert retry_after(FakeErr(), 60) == 60  # HTTP-date form -> fall back
    assert retry_after(RuntimeError("no headers"), 60) == 60

    # The file format is the contract with FileUsageProvider.qml, which reads
    # windows[*].utilization, windows[*].resetAt and updatedAt. Changing a key
    # here silently blanks the widget, so pin the shape.
    global USAGE_FILE
    with tempfile.TemporaryDirectory() as d:
        USAGE_FILE = os.path.join(d, "usage.json")
        write_usage({
            "five_hour": {"utilization": 68, "resets_at": "2026-07-30T18:00:00Z"},
            "seven_day": {"utilization": 41.5, "resets_at": "2026-08-03T00:00:00Z"},
        })
        written = json.load(open(USAGE_FILE))
        assert set(written) == {"windows", "updatedAt"}, written
        assert set(written["windows"]) == {"five_hour", "seven_day"}, written
        for w in written["windows"].values():
            assert set(w) == {"utilization", "resetAt"}, w
            assert 0.0 <= w["utilization"] <= 1.0, w
        assert written["windows"]["five_hour"]["utilization"] == 0.68
        assert written["updatedAt"].endswith("Z")

        # An auth error lands in the file without clobbering the numbers...
        write_error("re-auth me")
        after_err = json.load(open(USAGE_FILE))
        assert after_err["error"] == "re-auth me", after_err
        assert set(after_err["windows"]) == {"five_hour", "seven_day"}, after_err
        # ...and the next successful poll clears it (pinned by the exact-keys
        # assertion above too, but say it explicitly).
        write_usage({"five_hour": {"utilization": 10, "resets_at": "T"}})
        assert "error" not in json.load(open(USAGE_FILE))
        # No prior file: the error-only payload still has the contract keys.
        USAGE_FILE = os.path.join(d, "fresh", "usage.json")
        write_error("no creds")
        fresh = json.load(open(USAGE_FILE))
        assert set(fresh) == {"windows", "updatedAt", "error"}, fresh
        assert fresh["windows"] == {}

    with tempfile.TemporaryDirectory() as d:
        p = os.path.join(d, "sub", "usage.json")
        write_atomic(p, '{"a":1}', mode=0o600)
        assert json.load(open(p)) == {"a": 1}
        assert os.stat(p).st_mode & 0o777 == 0o600
        assert not [n for n in os.listdir(os.path.dirname(p)) if n.startswith(".tmp-")]

        # save_oauth must not drop the keys Claude Code owns.
        CREDENTIALS_FILE = os.path.join(d, ".credentials.json")
        write_atomic(CREDENTIALS_FILE, json.dumps({
            "claudeAiOauth": {"accessToken": "old"},
            "mcpOAuth": {"keep": "me"},
            "organizationUuid": "org-1",
        }), mode=0o600)
        save_oauth({"accessToken": "new"})
        after = json.load(open(CREDENTIALS_FILE))
        assert after == {
            "claudeAiOauth": {"accessToken": "new"},
            "mcpOAuth": {"keep": "me"},
            "organizationUuid": "org-1",
        }, after
        assert os.stat(CREDENTIALS_FILE).st_mode & 0o777 == 0o600

        # A missing credential file must not crash the write path.
        CREDENTIALS_FILE = os.path.join(d, "absent.json")
        save_oauth({"accessToken": "fresh"})
        assert json.load(open(CREDENTIALS_FILE)) == {"claudeAiOauth": {"accessToken": "fresh"}}

        # Missing or gutted credentials classify as AuthError (a state only the
        # user can fix), not as a generic error to back off on forever.
        CREDENTIALS_FILE = os.path.join(d, "nope.json")
        try:
            get_usage()
            raise SystemExit("selftest: expected AuthError for missing credentials")
        except AuthError:
            pass
        CREDENTIALS_FILE = os.path.join(d, "empty.json")
        write_atomic(CREDENTIALS_FILE, "{}", mode=0o600)
        try:
            get_usage()
            raise SystemExit("selftest: expected AuthError for missing claudeAiOauth")
        except AuthError:
            pass

        # Second instance is refused while the first holds the lock.
        STATE_DIR = os.path.join(d, "state")
        LOCK_FILE = os.path.join(STATE_DIR, "daemon.lock")
        first = single_instance_lock()
        assert first is not None
        assert single_instance_lock() is None
        os.close(first)
        second = single_instance_lock()
        assert second is not None  # freed once the holder exits
        os.close(second)

        # The hourly prime ceiling lives on disk, so a restart loop cannot spend
        # once per restart. Absent stamp means "never primed" -> allowed.
        PRIME_STAMP_FILE = os.path.join(STATE_DIR, "last-prime")
        assert last_prime_at() == float("-inf")
        assert prime_gap_elapsed()[0]
        record_prime()
        assert not prime_gap_elapsed()[0], "a prime one second ago must refuse"
        assert os.stat(PRIME_STAMP_FILE).st_mode & 0o777 == 0o600
        record_prime(time.time() - MIN_PRIME_GAP - 1)
        assert prime_gap_elapsed()[0], "past the gap must allow"
        # A stamp in the future means the clock stepped backwards. Allow rather
        # than locking priming out until the clock catches up.
        record_prime(time.time() + 86400)
        assert prime_gap_elapsed()[0], "a future stamp must not block priming"
        # Garbage in the file must read as "never primed", not crash the loop.
        write_atomic(PRIME_STAMP_FILE, "not a number", mode=0o600)
        assert last_prime_at() == float("-inf")

    print("selftest ok")


def prime_now():
    """--prime-now: open a five-hour window from the command line.

    Takes the single-instance lock first. Refreshing the token from two
    processes at once is the one thing that can invalidate the credentials
    Claude Code owns, so if a daemon is already running this defers to it
    instead of racing it.

    Deliberately not subject to MIN_PRIME_GAP: someone typing this has decided
    to spend, and a tool that silently declines is worse than one that obeys.
    It still records the stamp, so an automatic prime cannot double-spend on
    top of it within the hour.
    """
    if single_instance_lock() is None:
        raise SystemExit("kclaude-daemon: a daemon is already running; ask it instead:\n"
                         "  systemctl --user kill -s USR2 kclaude.service")
    prime_session()


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    elif "--prime-now" in sys.argv:
        prime_now()
    else:
        main()
