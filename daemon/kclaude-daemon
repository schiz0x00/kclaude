        assert written["plan"] == "max"
        assert written["account"] == "solo"
        assert set(written["windows"]) == {"five_hour", "seven_day"}, written
        for w in written["windows"].values():
            assert set(w) == {"utilization", "resetAt"}, w
            assert 0.0 <= w["utilization"] <= 1.0, w
        assert written["windows"]["five_hour"]["utilization"] == 0.68
        assert written["updatedAt"].endswith("Z")

