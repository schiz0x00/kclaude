    # At 100% the daemon goes quiet until the window turns over. Retrying into
    # a refusal is the one behaviour this must never have.
    now = datetime.datetime.fromisoformat("2026-07-30T05:00:00Z").timestamp()
    spent = {"five_hour": {"utilization": 100.0, "resets_at": "2026-07-30T05:20:00Z"}}
    assert exhausted_until(spent, now) == 20 * 60 + RESET_SLACK
    # Not exhausted -> no wait, so the normal interval stands.
    assert exhausted_until({"five_hour": {"utilization": 99.9, "resets_at": "T"}}, now) is None
    assert exhausted_until({}, now) is None
    # A weekly budget that is spent refuses the same request for days: wait for
    # the window that frees the request, not the one that resets soonest.
    assert exhausted_until({
        "five_hour": {"utilization": 100.0, "resets_at": "2026-07-30T05:20:00Z"},
        "seven_day": {"utilization": 100.0, "resets_at": "2026-07-30T06:00:00Z"},
    }, now) == 60 * 60 + RESET_SLACK
    # ...and no wait outlives one window, however far off the reset claims to be.
    assert exhausted_until(
        {"seven_day": {"utilization": 100.0, "resets_at": "2026-08-03T05:00:00Z"}},
        now) == FIVE_HOURS
    # A reset already in the past means wake soon -- but "soon" is bounded by
    # this daemon's own floor. It used to be exactly RESET_SLACK (10s), which is
    # below MIN_POLL_GAP and six times below MIN_INTERVAL, so a clock skew, a
    # stale header or a naive resets_at on a machine east of UTC turned a spent
    # window into a 10-second ping loop against an endpoint that was refusing.
    assert exhausted_until(
        {"five_hour": {"utilization": 100.0, "resets_at": "2026-07-30T04:00:00Z"}},
        now) == RESET_SLACK
    # Exhausted with an unusable reset time still waits, rather than spinning.
    assert exhausted_until({"five_hour": {"utilization": 100.0}}, now) == MAX_BACKOFF

