        assert prime_gap_elapsed(pb)[0], "another account's prime must not block this one"
        record_prime(pa, time.time() - MIN_PRIME_GAP - 1)
        assert prime_gap_elapsed(pa)[0], "past the gap must allow"
        # A stamp in the future means the clock stepped backwards. Allow rather
        # than locking priming out until the clock catches up.
        record_prime(pa, time.time() + 86400)
        assert prime_gap_elapsed(pa)[0], "a future stamp must not block priming"
        # Garbage in the file must read as "never primed", not crash the loop.
        write_atomic(pa.prime_stamp_file, "not a number", mode=0o600)
        assert last_prime_at(pa) == float("-inf")

    with quiet():
        # --- multiple accounts -------------------------------------------------
        #
        # Everything above proves one account still works. These prove the list does
        # what it says: the names, the isolation, and the reload.
        with tempfile.TemporaryDirectory() as d:
            ACCOUNTS_FILE = os.path.join(d, "accounts.json")

            # A missing file is what every pre-multi-account install looks like, and
            # it has to keep working rather than take the widget down.
            try:
                os.unlink(ACCOUNTS_FILE)
            except FileNotFoundError:
                pass
            solo = load_accounts(d)
            assert len(solo) == 1
            assert solo[0].config_dir == DEFAULT_CONFIG_DIR
            assert solo[0].usage_file == os.path.join(d, "usage.json"), solo[0].usage_file
            assert solo[0].scoped_file == os.path.join(d, "scoped.json")

            write_atomic(ACCOUNTS_FILE, json.dumps({"version": 1, "accounts": [
                {"id": "Max", "label": "Personal", "path": os.path.join(d, "c1")},
                {"id": "claude dad", "label": "", "path": os.path.join(d, "c2")},
            ]}))
            two = load_accounts(d)
            assert [a.id for a in two] == ["max", "claude_dad"], [a.id for a in two]
            assert two[0].label == "Personal"
            # An empty label falls back to the id rather than to a blank row.
            assert two[1].label == "claude_dad", two[1].label
            # The first account keeps the historical unsuffixed names; the rest are
            # suffixed, so two accounts cannot share one usage file.
            assert two[0].usage_file == os.path.join(d, "usage.json")
            assert two[0].scoped_file == os.path.join(d, "scoped.json")
            assert two[0].prime_stamp_file == os.path.join(d, "last-prime")
            assert two[1].usage_file == os.path.join(d, "usage-claude_dad.json")
            assert two[1].scoped_file == os.path.join(d, "scoped-claude_dad.json")
            assert two[1].prime_stamp_file == os.path.join(d, "last-prime-claude_dad")
            assert len({a.usage_file for a in two}) == 2

            # A "~" in the path is the form people actually type, and the widget
            # writes it, so it has to expand here rather than becoming a literal
            # "~/.claude-dad" directory that does not exist.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                {"id": "tilde", "path": "~/somewhere"}]}))
            assert load_accounts(d)[0].config_dir == os.path.expanduser("~/somewhere")

            # One bad entry must not cost the user the accounts that are fine.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                "not an object",
                {"label": "no id at all"},
                # A non-string or empty path must be dropped, never pointed at
                # ~/.claude: that would file the default account's numbers under
                # this entry's name.
                {"id": "nopath", "path": 42},
                {"id": "blankpath", "path": "   "},
                {"id": "ok1", "path": os.path.join(d, "c1")},
                {"id": "ok1", "path": os.path.join(d, "c2")},  # duplicate id
                {"id": "ok2", "path": os.path.join(d, "c3")},
            ]}))
            three = load_accounts(d)
            assert [a.id for a in three] == ["ok1", "ok2"], [a.id for a in three]
            assert three[1].usage_file == os.path.join(d, "usage-ok2.json")
            assert three[0].config_dir == os.path.join(d, "c1")

            # Every shape of unusable file lands on the single default account
            # rather than on zero accounts, which would have the loop divide by
            # nothing and show an empty widget.
            for junk in ("not json", "{}", '{"accounts": []}', '{"accounts": "no"}',
                         '{"accounts": [1, 2, 3]}'):
                write_atomic(ACCOUNTS_FILE, junk)
                fallback = load_accounts(d)
                assert len(fallback) == 1 and fallback[0].config_dir == DEFAULT_CONFIG_DIR, junk

            # The cap is enforced, and the excess is dropped from the end so the
            # first account the user listed is always the one that is primary.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                {"id": f"a{i}", "path": os.path.join(d, f"c{i}")} for i in range(MAX_ACCOUNTS + 4)]}))
            capped = load_accounts(d)
            assert len(capped) == MAX_ACCOUNTS, len(capped)
            assert capped[0].id == "a0"

            # The cap is on how many accounts are *kept*, not how many entries
            # are read. Slicing the input meant a file whose first MAX_ACCOUNTS
            # entries were all unusable fell through to the default account
            # even when entry nine was perfectly good -- and the widget, which
            # caps its own output, disagreed with the collector about which rows
            # exist at all.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts":
                [{"id": "", "path": ""}] * MAX_ACCOUNTS
                + [{"id": "survivor", "path": os.path.join(d, "good")}]}))
            rescued = load_accounts(d)
            assert [a.id for a in rescued] == ["survivor"], [a.id for a in rescued]

            # A damaged accounts.json is not a decision to watch ~/.claude. The
            # collector used to reload from it and repoint every account at the
            # default on the next pass, which also means refreshing a token the
            # user may not have chosen.
            write_atomic(ACCOUNTS_FILE, '{"accounts": [{"id": "x", "path"')
            assert accounts_file_state() == "unreadable"
            kept = load_accounts(d)
            with quiet():
                # Failing closed: the list already running is kept, unchanged.
                same = reload_accounts(rescued)
            assert [a.id for a in same] == ["survivor"], [a.id for a in same]
            # Absent is a different thing, and still means the default account.
            os.unlink(ACCOUNTS_FILE)
            assert accounts_file_state() == "missing"
            assert load_accounts(d)[0].id == "claude"
            # Left with the list the cases below go on to use, which is the one
            # they were written against rather than whatever this block ended on.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                {"id": "a0", "path": os.path.join(d, "c0")},
                {"id": "a1", "path": os.path.join(d, "c1")},
                {"id": "a2", "path": os.path.join(d, "c2")}]}))

            # A rename or a reorder keeps the running account's pacing and cache: a
            # fresh object would reset an hour of error backoff and spend an
            # endpoint call the previous poll already earned the right to spend.
            before = load_accounts(d)
            before[1].backoff = 1800.0
            before[1].next_due = 12345.0
            before[1].scoped._windows = {"fable": {"utilization": 22, "resets_at": "T"}}
            before[1].scoped._fetched_at = 999.0
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                {"id": "a0", "label": "renamed", "path": os.path.join(d, "c0")},
                {"id": "a1", "path": os.path.join(d, "c1")},
            ]}))
            after_reload = reload_accounts(before)
            assert len(after_reload) == 2
            assert after_reload[0] is before[0], "an unchanged account keeps its object"
            assert after_reload[0].label == "renamed"
            assert after_reload[1] is before[1]
            assert after_reload[1].backoff == 1800.0
            assert after_reload[1].next_due == 12345.0
            assert after_reload[1].scoped._fetched_at == 999.0
            assert after_reload[1].scoped._windows == {"fable": {"utilization": 22, "resets_at": "T"}}
            # A label is not a scheduling change, so a rename must not look like one.
            assert accounts_signature(after_reload) == accounts_signature(load_accounts(d))
            # A changed path is a different account on purpose: its credentials live
            # somewhere else entirely.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                {"id": "a0", "path": os.path.join(d, "c0")},
                {"id": "a1", "path": os.path.join(d, "moved")},
            ]}))
            moved = reload_accounts(after_reload)
            assert moved[1] is not after_reload[1], "a new path is a new account"
            assert moved[1].config_dir == os.path.join(d, "moved")
            # Reordering re-points the state files, because the primary slot is
            # unsuffixed and a swap has to move with it.
            write_atomic(ACCOUNTS_FILE, json.dumps({"accounts": [
                {"id": "a1", "path": os.path.join(d, "c1")},
                {"id": "a0", "path": os.path.join(d, "c0")},
            ]}))
            swapped = reload_accounts(moved)
            assert [a.id for a in swapped] == ["a1", "a0"]
            assert swapped[0].usage_file == os.path.join(d, "usage.json"), swapped[0].usage_file
            assert swapped[1].usage_file == os.path.join(d, "usage-a0.json"), swapped[1].usage_file
            assert swapped[0].scoped._path == swapped[0].scoped_file

        # Pro accounts cannot have a per-model weekly budget, so the scarce endpoint
        # call is not worth making for them -- and a downgrade must take the window
        # away rather than leave a phantom bar on the panel.
        with tempfile.TemporaryDirectory() as d:
            pro = Account({"id": "pro", "path": os.path.join(d, "pro")}, 0, d)
            pro.plan = "pro"
            pro.scoped._windows = {"fable": {"utilization": 22, "resets_at": "2026-09-29T19:00:00+00:00"}}
            pro.scoped._fetched_at = time.time()
            pro.scoped._next_attempt = 0.0
            spent_calls = []
            assert not pro.scoped.refresh(lambda _a: spent_calls.append(1))
            assert not spent_calls, "a plan that cannot have the answer must not spend a call"
            assert pro.scoped._windows == {}, "a downgrade has to drop the window it had"
            assert not pro.scoped.refresh(lambda _a: spent_calls.append(1))
            assert len(spent_calls) == 0
            # And the merge adds nothing, so the widget has no Fable row to draw.
            assert pro.scoped.apply({"five_hour": {"utilization": 0.5, "resetAt": "T"}}) \
                == {"five_hour": {"utilization": 0.5, "resetAt": "T"}}
            # A max account is unaffected by the skip.
            mx = Account({"id": "mx", "path": os.path.join(d, "mx")}, 1, d)
            mx.plan = "max"
            got = []
            assert mx.scoped.refresh(lambda _a: got.append(1) or {"limits": [
                {"kind": "weekly_scoped", "percent": 22, "resets_at": "2026-09-29T19:59:59Z",
                 "scope": {"model": {"display_name": "Fable"}}}]})
            assert len(got) == 1
            assert "fable" in mx.scoped.apply({})

        # Scheduling. The point of all of it: one account's problem is that account's
        # problem, and a signal cannot become a way around a backoff.
        with tempfile.TemporaryDirectory() as d:
            fast = Account({"id": "fast", "path": os.path.join(d, "fast")}, 0, d)
            slow = Account({"id": "slow", "path": os.path.join(d, "slow")}, 1, d)
            base = time.monotonic()
            fast.next_due = base + 60
            slow.next_due = base + 3600
            # The minimum, not the maximum: an account in an hour of backoff must
            # not hold the other one at that cadence.
            assert 55 <= seconds_until_next([fast, slow]) <= 60, seconds_until_next([fast, slow])
            slow.next_due = base + 5
            assert 1 <= seconds_until_next([fast, slow]) <= 5
            # Never zero, so a due-everything pass cannot become a spin.
            fast.next_due = slow.next_due = base - 10
            assert seconds_until_next([fast, slow]) == 1.0

            # A manual refresh comes forward only as far as the floor allows.
            for a in (fast, slow):
                a.last_poll = base
                a.wake_floor = 30.0
                a.next_due = base + 3600
            request_poll([fast, slow])
            assert fast.next_due == base + 30.0
            assert slow.next_due == base + 30.0
            # During an error backoff the floor is the whole backoff, so a refresh
            # cannot short-circuit it -- which is how one 429 becomes a hammer.
            fast.wake_floor = 3600.0
            fast.next_due = base + 7200
            request_poll([fast])
            assert fast.next_due == base + 3600.0
            # A prime that succeeded zeroes the floor, because its numbers are
            # seconds old and there is nothing left to wait for.
            fast.wake_floor = 0.0
            fast.next_due = base + 3600
            request_poll([fast])
            assert fast.next_due == base

        # poll_account contains failure per account: a dead login on one must not
        # stop the other updating, and must not raise out of the loop either.
        with tempfile.TemporaryDirectory() as d:
            good = Account({"id": "good", "path": os.path.join(d, "good")}, 0, d)
            bad = Account({"id": "bad", "path": os.path.join(d, "bad")}, 1, d)
            real_ping_account = ping_usage
            try:
                def fake_ping(account):
                    if account is bad:
                        raise AuthError("login expired")
                    return {"five_hour": {"utilization": 42, "resets_at": "T"}}
                ping_usage = fake_ping
                poll_account(good, 60)
                poll_account(bad, 60)  # must not raise
            finally:
                ping_usage = real_ping_account
            assert json.load(open(good.usage_file))["windows"]["five_hour"]["utilization"] == 0.42
            assert "error" in json.load(open(bad.usage_file))
            # The failure is isolated to that account's own file.
            assert "error" not in json.load(open(good.usage_file))
            # Both are scheduled, and the dead one backs off while the live one
            # keeps the normal cadence.
            assert good.backoff == 60 and good.next_due > 0
            assert bad.backoff == 120, bad.backoff  # doubled from the initial 60
            assert bad.wake_floor == MIN_POLL_GAP, "a re-auth is fixed by the user, not by waiting"
            # And a limit that is spent quiets only its own account. The reset
            # has to be in the future: exhausted_until() clamps a reset that has
            # already passed down to RESET_SLACK, because "wake now" is the right
            # answer for a window that turned over an hour ago.
            spent_acct = Account({"id": "spent", "path": os.path.join(d, "spent")}, 0, d)
            future_reset = iso(time.time() + 20 * 60)
            try:
                ping_usage = lambda _a: {"five_hour": {"utilization": 100.0,
                                                        "resets_at": future_reset}}
                poll_account(spent_acct, 60)
            finally:
                ping_usage = real_ping_account
            assert spent_acct.next_due > time.monotonic() + 60, spent_acct.next_due

            # A spent window whose reset has *already passed* -- a clock skew, a
            # stale header, a naive resets_at read on a machine east of UTC --
            # used to be polled every RESET_SLACK (10s). That is below this
            # daemon's own MIN_POLL_GAP and six times below MIN_INTERVAL, so the
            # one behaviour this file exists to avoid, pinging into a refusal,
            # was reachable by nothing more than a wrong timestamp.
            stale_acct = Account({"id": "stale", "path": os.path.join(d, "stale")}, 0, d)
            past_reset = iso(time.time() - 3600)
            try:
                ping_usage = lambda _a: {"five_hour": {"utilization": 100.0,
                                                        "resets_at": past_reset}}
                poll_account(stale_acct, 60)
            finally:
                ping_usage = real_ping_account
            assert stale_acct.wake_floor >= MIN_POLL_GAP, stale_acct.wake_floor
            assert stale_acct.next_due - time.monotonic() >= MIN_POLL_GAP, stale_acct.next_due

            # No path through a poll may schedule this daemon faster than
            # MIN_POLL_GAP, whatever the numbers say.
            for account in (good, bad, spent_acct, stale_acct):
                assert account.next_due - time.monotonic() >= MIN_POLL_GAP, account.id

            # poll_account promises "Never raises" so that one account's dead
            # login cannot stop the other updating. Its own AuthError handler
            # used to do unguarded I/O, so one unwritable state directory plus
            # one expired login took down every account, and Restart=on-failure
            # with RestartSec=30 turned that into a loop.
            unwritable = Account({"id": "unwritable", "path": os.path.join(d, "unwritable")}, 0,
                                 os.path.join(d, "no-such-state-dir"))
            # Point the state dir at a path that cannot be a directory, so every
            # write inside it fails with a plain OSError.
            os.makedirs(os.path.join(d, "blocked"), exist_ok=True)
            unwritable.state_dir = os.path.join(d, "blocked", "not-a-dir")
            try:
                ping_usage = lambda _a: (_ for _ in ()).throw(AuthError("login expired"))
                poll_account(unwritable, 60)  # must not raise
            finally:
                ping_usage = real_ping_account
            # The schedule is still set, which is the part that matters: the
            # account is retried rather than left with a stale next_due.
            assert unwritable.next_due > time.monotonic() + MIN_POLL_GAP, unwritable.next_due
            assert unwritable.backoff >= 60, unwritable.backoff


    print("selftest ok")


def prime_now():
    """--prime-now: open a five-hour window from the command line.

    Takes the single-instance lock first. Refreshing the token from two
    processes at once is the one thing that can invalidate the credentials
    Claude Code owns, so if a daemon is already running this defers to it
    instead of racing it.

    Primes the first configured account, which is the one --prime-now meant
    before there was more than one; the running daemon primes all of them.

    Deliberately not subject to MIN_PRIME_GAP: someone typing this has decided
    to spend, and a tool that silently declines is worse than one that obeys.
    It still records the stamp, so an automatic prime cannot double-spend on
    top of it within the hour.
    """
    if single_instance_lock() is None:
        raise SystemExit("kclaude-daemon: a daemon is already running; ask it instead:\n"
                         "  systemctl --user kill -s USR2 kclaude.service")
    prime_session(load_accounts()[0])


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    elif "--prime-now" in sys.argv:
        prime_now()
    else:
        main()
